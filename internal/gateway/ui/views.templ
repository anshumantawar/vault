package ui

import "fmt"

// Desktop is the whole OS shell; apps load into windows via htmx.
templ Desktop() {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>Vault OS</title>
			<link rel="icon" href="data:,"/>
			<script>
				// Apply the saved theme before first paint, so there's no flash.
				try { const t = localStorage.getItem('vault-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
			</script>
			<script src="/static/htmx.min.js"></script>
			<style>
				:root {
					color-scheme: light dark;
					--bg: #eceae6; --win: #fbfaf8; --text: #1c1b19; --muted: #7a766f; --line: #dedad3; --soft: #f1efeb;
					--ok: #2f9e5b; --warn: #d4870b; --bad: #d64534; --idle: #d7d3cc; --accent: #1c1b19;
					--shadow: 0 1px 2px rgba(0,0,0,.06), 0 12px 32px rgba(0,0,0,.10);
					--wallpaper: url(/static/wallpaper-light.svg);
				}
				:root[data-theme="light"] { color-scheme: light; }
				@media (prefers-color-scheme: dark) {
					:root:not([data-theme="light"]) {
						--wallpaper: url(/static/wallpaper-dark.svg);
						--bg: #121212; --win: #1c1c1c; --text: #ecebe8; --muted: #8d8a84; --line: #2c2c2c; --soft: #242424;
						--ok: #46c07a; --warn: #f0a531; --bad: #f0634f; --idle: #333; --accent: #ecebe8;
						--shadow: 0 1px 2px rgba(0,0,0,.4), 0 16px 40px rgba(0,0,0,.5);
					}
				}
				:root[data-theme="dark"] {
					color-scheme: dark;
					--wallpaper: url(/static/wallpaper-dark.svg);
					--bg: #121212; --win: #1c1c1c; --text: #ecebe8; --muted: #8d8a84; --line: #2c2c2c; --soft: #242424;
					--ok: #46c07a; --warn: #f0a531; --bad: #f0634f; --idle: #333; --accent: #ecebe8;
					--shadow: 0 1px 2px rgba(0,0,0,.4), 0 16px 40px rgba(0,0,0,.5);
				}
				.deck { height: 100%; display: flex; flex-direction: column; gap: 14px; }
				.slide { flex: 1; overflow: auto; display: flex; flex-direction: column; gap: 12px; }
				.slide h1 { font-size: 26px; line-height: 1.2; margin: 0; letter-spacing: -.01em; }
				.slide h2 { font-size: 20px; margin: 0; }
				.slide .kicker { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
				.slide p, .slide li { font-size: 14px; line-height: 1.55; }
				.slide ul, .slide ol { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
				.cover { justify-content: center; align-items: flex-start; }
				.cover h1 { font-size: 56px; }
				.cover .tags { display: flex; gap: 6px; flex-wrap: wrap; }
				.tag { border: 1px solid var(--line); border-radius: 99px; padding: 2px 10px; font-size: 12px; color: var(--muted); }
				blockquote { margin: 0; padding: 4px 0 4px 16px; border-left: 3px solid var(--text); display: grid; gap: 10px; }
				blockquote p { margin: 0; font-size: 16px !important; }
				.req { display: grid; grid-template-columns: minmax(150px, 34%) 1fr; gap: 0; }
				.req > div { padding: 5px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
				.req > div:nth-child(odd) { font-weight: 600; padding-right: 12px; }
				.arch { display: grid; gap: 10px; }
				.tier { display: grid; grid-template-columns: 110px 1fr; gap: 10px; align-items: center; }
				.tier > span { font-size: 11px; color: var(--muted); text-transform: uppercase; letter-spacing: .06em; }
				.boxes { display: flex; gap: 6px; flex-wrap: wrap; }
				.box { border: 1px solid var(--line); background: var(--soft); border-radius: 7px; padding: 6px 10px; font-size: 12px; }
				.box.strong { background: var(--text); color: var(--win); border-color: var(--text); }
				.arrow { color: var(--muted); padding-left: 120px; font-size: 12px; }
				.cols { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
				table.grid-t { border-collapse: collapse; width: 100%; font-size: 13px; }
				table.grid-t th, table.grid-t td { text-align: left; padding: 6px 8px 6px 0; border-bottom: 1px solid var(--line); }
				table.grid-t th { color: var(--muted); font-weight: 500; font-size: 11px; }
				.say { display: grid; gap: 8px; }
				.watch { border: 1px solid var(--line); border-radius: 8px; padding: 8px 12px; background: var(--soft); font-size: 13px; }
				.cmd { display: flex; gap: 6px; align-items: flex-start; }
				.cmd pre { flex: 1; margin: 0; white-space: pre-wrap; word-break: break-all; }
				#deck-out:not(:empty) { font-size: 12px; color: var(--muted); }
				.deck-nav { display: flex; align-items: center; gap: 8px; flex: none; }
				.deck-nav .bar { flex: 1; height: 3px; background: var(--soft); border-radius: 2px; overflow: hidden; }
				.deck-nav .bar i { display: block; height: 100%; background: var(--text); }
				.win:fullscreen { border-radius: 0; }
				.win:fullscreen .win-body { padding: 5vh 8vw; }
				.win:fullscreen .slide { font-size: 1.3em; }
				.win:fullscreen .slide h1 { font-size: 40px; }
				.win:fullscreen .cover h1 { font-size: 88px; }
				.win:fullscreen .slide p, .win:fullscreen .slide li, .win:fullscreen .req > div { font-size: 18px; }
				.win:fullscreen blockquote p { font-size: 22px !important; }
				* { box-sizing: border-box; }
				html, body { height: 100%; margin: 0; }
				body { background: var(--bg) var(--wallpaper) center / cover no-repeat fixed; color: var(--text); font: 13px/1.45 ui-sans-serif, system-ui, -apple-system, sans-serif; overflow: hidden; }
				button, input, select { font: inherit; color: inherit; }
				#bar { position: fixed; inset: 0 0 auto 0; height: 30px; display: flex; align-items: center; gap: 4px; padding: 0 10px; z-index: 100000;
					background: color-mix(in srgb, var(--win) 72%, transparent); backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px);
					border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent); font-size: 13px; }
				#bar .item { display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 8px; border-radius: 5px; white-space: nowrap; }
				#bar .logo { width: 16px; height: 16px; border-radius: 4px; background: var(--text); color: var(--win); display: grid; place-items: center; font-size: 10px; font-weight: 800; }
				#bar .app { font-weight: 700; }
				#bar .hint { color: var(--muted); }
				#bar .spacer { flex: 1; }
				#bar .status { font-size: 12px; }
				#bar .status .muted { font-size: 12px; }
				.muted { color: var(--muted); }
				.dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--ok); margin-right: 6px; vertical-align: 1px; box-shadow: 0 0 0 2px color-mix(in srgb, var(--ok) 22%, transparent); }
				.dot.warn { background: var(--warn); box-shadow: 0 0 0 2px color-mix(in srgb, var(--warn) 22%, transparent); }
				.dot.bad { background: var(--bad); box-shadow: 0 0 0 2px color-mix(in srgb, var(--bad) 22%, transparent); }
				.dot.idle { background: var(--idle); box-shadow: none; }
				.theme { display: inline-flex; gap: 1px; padding: 2px; border-radius: 7px; background: color-mix(in srgb, var(--text) 7%, transparent); }
				.theme button { border: 0; background: transparent; width: 24px; height: 18px; border-radius: 5px; cursor: pointer; color: var(--muted); display: grid; place-items: center; padding: 0; }
				.theme button svg { width: 12px; height: 12px; }
				.theme button[aria-pressed="true"] { background: var(--win); color: var(--text); box-shadow: 0 1px 2px rgba(0,0,0,.15); }
				#clock { font-variant-numeric: tabular-nums; }
				#desk { position: fixed; inset: 30px 0 84px 0; }
				#dock { position: fixed; left: 50%; bottom: 10px; transform: translateX(-50%); display: flex; align-items: flex-end; gap: 4px; padding: 5px 6px; z-index: 100000;
					background: color-mix(in srgb, var(--win) 60%, transparent); backdrop-filter: saturate(180%) blur(24px); -webkit-backdrop-filter: saturate(180%) blur(24px);
					border: 1px solid color-mix(in srgb, var(--line) 80%, transparent); border-radius: 18px; box-shadow: var(--shadow); }
				#dock button { position: relative; border: 0; background: transparent; padding: 0 3px 7px; cursor: pointer; }
				#dock .ico { width: 46px; height: 46px; border-radius: 11px; display: grid; place-items: center; color: #fff; transition: transform .15s ease; box-shadow: inset 0 0 0 1px rgba(255,255,255,.12), 0 2px 6px rgba(0,0,0,.18); }
				#dock .ico svg { width: 24px; height: 24px; }
				#dock button:hover .ico { transform: translateY(-5px) scale(1.08); }
				#dock .d-files .ico { background: linear-gradient(160deg, #5aa9ff, #1f6fe5); }
				#dock .d-stats .ico { background: linear-gradient(160deg, #4cd98a, #179a55); }
				#dock .d-connect .ico { background: linear-gradient(160deg, #4a4a4f, #1d1d20); }
				#dock .d-present .ico { background: linear-gradient(160deg, #ffb347, #f06a1f); }
				#dock .doc .ico { background: linear-gradient(160deg, #c6c6cc, #8e8e96); font-size: 11px; font-weight: 700; }
				#dock .tip { position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%); padding: 3px 9px; border-radius: 6px; font-size: 12px; white-space: nowrap;
					background: var(--win); border: 1px solid var(--line); box-shadow: var(--shadow); opacity: 0; pointer-events: none; transition: opacity .12s; }
				#dock button:hover .tip { opacity: 1; }
				#dock .run { position: absolute; bottom: 1px; left: 50%; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: var(--text); opacity: 0; }
				#dock button.running .run { opacity: .7; }
				#dock .sep { width: 1px; align-self: stretch; margin: 4px 4px 10px; background: var(--line); }
				#dock .sep:last-child { display: none; }
				.win { position: absolute; display: flex; flex-direction: column; min-width: 320px; min-height: 200px; background: var(--win); border-radius: 12px;
					border: 1px solid color-mix(in srgb, var(--line) 90%, transparent); box-shadow: var(--shadow);
					transition: opacity .18s ease, transform .18s ease; transform-origin: 50% 100%; }
				.win:not(.active) { box-shadow: 0 1px 2px rgba(0,0,0,.05), 0 6px 18px rgba(0,0,0,.07); }
				.win.min { opacity: 0; transform: translateY(40vh) scale(.2); pointer-events: none; }
				.win.max { border-radius: 0; }
				.win.moving { transition: none; }
				.win-bar { position: relative; display: flex; align-items: center; height: 38px; padding: 0 12px; flex: none; user-select: none; border-bottom: 1px solid var(--line); border-radius: 12px 12px 0 0; }
				.win.max .win-bar { border-radius: 0; }
				.win-title { position: absolute; left: 90px; right: 90px; text-align: center; font-weight: 600; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; pointer-events: none; }
				.win:not(.active) .win-title { color: var(--muted); }
				.lights { display: flex; gap: 8px; z-index: 1; }
				.lights button { width: 12px; height: 12px; padding: 0; border-radius: 50%; border: 0; cursor: default; display: grid; place-items: center; box-shadow: inset 0 0 0 .5px rgba(0,0,0,.18); }
				.lights svg { width: 8px; height: 8px; opacity: 0; stroke: rgba(0,0,0,.55); stroke-width: 1.6; fill: none; stroke-linecap: round; }
				.lights:hover svg { opacity: 1; }
				.l-close { background: #ff5f57; } .l-min { background: #febc2e; } .l-max { background: #28c840; }
				.win:not(.active) .lights:not(:hover) button { background: var(--idle); box-shadow: none; }
				.win-body { flex: 1; overflow: auto; padding: 14px; border-radius: 0 0 12px 12px; }
				.win.max .win-body { border-radius: 0; }
				.rz { position: absolute; z-index: 2; }
				.rz.n { top: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; } .rz.s { bottom: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
				.rz.e { right: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; } .rz.w { left: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
				.rz.ne { top: -4px; right: -4px; width: 12px; height: 12px; cursor: nesw-resize; } .rz.sw { bottom: -4px; left: -4px; width: 12px; height: 12px; cursor: nesw-resize; }
				.rz.nw { top: -4px; left: -4px; width: 12px; height: 12px; cursor: nwse-resize; } .rz.se { bottom: -4px; right: -4px; width: 12px; height: 12px; cursor: nwse-resize; }
				.win.max .rz { display: none; }
				#ctx { position: fixed; z-index: 200000; min-width: 210px; padding: 5px; border-radius: 9px; font-size: 13px;
					background: color-mix(in srgb, var(--win) 82%, transparent); backdrop-filter: saturate(180%) blur(24px); -webkit-backdrop-filter: saturate(180%) blur(24px);
					border: 1px solid color-mix(in srgb, var(--line) 90%, transparent); box-shadow: 0 10px 30px rgba(0,0,0,.22), 0 0 0 .5px rgba(0,0,0,.08); }
				#ctx .h { padding: 4px 10px 2px; font-size: 11px; font-weight: 600; color: var(--muted); max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
				#ctx button { display: flex; width: 100%; align-items: center; gap: 8px; padding: 3px 10px 3px 6px; border: 0; border-radius: 5px; background: transparent; text-align: left; cursor: default; white-space: nowrap; }
				#ctx button .chk { width: 14px; text-align: center; font-size: 11px; }
				#ctx button:hover, #ctx button:focus-visible { background: #0a64d8; color: #fff; outline: none; }
				#ctx button.danger { color: var(--bad); }
				#ctx button.danger:hover { color: #fff; background: var(--bad); }
				#ctx hr { border: 0; height: 1px; margin: 4px 6px; background: var(--line); }
				#toast { position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%); z-index: 200000; padding: 6px 14px; border-radius: 8px; font-size: 12px;
					background: var(--text); color: var(--win); box-shadow: var(--shadow); opacity: 0; transition: opacity .2s; pointer-events: none; }
				#toast.show { opacity: 1; }
				.btn { border: 1px solid var(--line); background: var(--win); border-radius: 7px; padding: 4px 10px; cursor: pointer; font-size: 12px; white-space: nowrap; }
				.btn:hover { border-color: var(--muted); }
				.btn.dark { background: var(--text); color: var(--win); border-color: var(--text); }
				.btn.on { background: var(--warn); border-color: var(--warn); color: #fff; }
				.btn.red { color: var(--bad); }
				.btn.xs { padding: 1px 7px; font-size: 11px; }
				input[type=text], select { border: 1px solid var(--line); background: var(--win); border-radius: 7px; padding: 4px 8px; }
				h3 { margin: 18px 0 8px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
				h3:first-child { margin-top: 0; }
				.err { color: var(--bad); margin: 0 0 10px; }
				.row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
				.files { min-height: 100%; display: flex; flex-direction: column; gap: 12px; border-radius: 8px; }
				.files.over { outline: 2px dashed var(--muted); outline-offset: -2px; }
				.toolbar { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
				.crumb { border: 0; background: transparent; padding: 2px 4px; cursor: pointer; border-radius: 5px; }
				.crumb:hover { background: var(--soft); }
				.crumb:last-of-type { font-weight: 600; }
				.sep { color: var(--muted); }
				.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 8px; }
				.tile { border: 1px solid transparent; background: transparent; border-radius: 8px; padding: 8px 6px; cursor: pointer; display: grid; justify-items: center; gap: 6px; text-align: center; min-width: 0; }
				.tile:hover { background: var(--soft); border-color: var(--line); }
				.thumb { width: 64px; height: 64px; border-radius: 8px; object-fit: cover; background: var(--soft); border: 1px solid var(--line); }
				.badge { width: 52px; height: 64px; border-radius: 6px; border: 1px solid var(--line); background: var(--soft); display: grid; place-items: end center; padding-bottom: 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--muted); }
				.folder { width: 64px; height: 48px; margin-top: 10px; border-radius: 6px; background: var(--idle); position: relative; }
				.folder::before { content: ""; position: absolute; left: 0; top: -6px; width: 26px; height: 10px; border-radius: 4px 4px 0 0; background: var(--idle); }
				.folder.bucket { background: var(--text); } .folder.bucket::before { background: var(--text); }
				.tile .name { font-size: 12px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
				.tile .sub { font-size: 11px; color: var(--muted); margin-top: -4px; }
				.empty { flex: 1; display: grid; place-items: center; color: var(--muted); border: 1px dashed var(--line); border-radius: 8px; padding: 32px; text-align: center; }
				.upload-form progress { display: none; width: 90px; height: 6px; }
				.upload-form.htmx-request progress { display: inline-block; }
				.upload-form.htmx-request label { display: none; }
				.stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 14px 10px; }
				.stat b { display: block; font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
				.stat span { font-size: 11px; color: var(--muted); }
				.health { display: flex; align-items: center; gap: 4px; font-size: 15px; font-weight: 600; margin-bottom: 14px; }
				.nodes { display: grid; gap: 6px; }
				.node { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; }
				.node.dead { background: color-mix(in srgb, var(--bad) 7%, transparent); }
				.node .id { font-weight: 600; }
				.chips { grid-column: 1 / -1; display: flex; gap: 4px; flex-wrap: wrap; align-items: center; font-size: 11px; }
				.heat { display: grid; gap: 2px; overflow-x: auto; }
				.hrow { display: flex; gap: 2px; align-items: center; }
				.hrow code, .hhead i { width: 76px; flex: none; font: 10px ui-monospace, monospace; color: var(--muted); }
				.hrow.degraded code { color: var(--warn); } .hrow.lost code { color: var(--bad); }
				.hhead { display: flex; gap: 2px; }
				.hhead span { width: 22px; flex: none; font-size: 10px; text-align: center; color: var(--muted); }
				.cell { width: 22px; height: 10px; flex: none; border-radius: 2px; background: var(--soft); }
				.cell.ok { background: var(--ok); } .cell.stale { background: var(--bad); opacity: .55; }
				.viewer { display: grid; gap: 14px; }
				.preview { display: grid; place-items: center; background: var(--soft); border-radius: 8px; min-height: 160px; overflow: hidden; }
				.preview img, .preview video { max-width: 100%; max-height: 320px; display: block; }
				.preview iframe { width: 100%; height: 280px; border: 0; background: #fff; }
				.preview audio { width: 90%; }
				table.kv { border-collapse: collapse; width: 100%; }
				table.kv td { padding: 3px 0; vertical-align: top; }
				table.kv td:first-child { color: var(--muted); width: 90px; }
				code, .mono { font: 11px ui-monospace, monospace; word-break: break-all; }
				.chunk { display: flex; align-items: center; gap: 8px; padding: 4px 0; border-bottom: 1px solid var(--line); }
				.pill { font-size: 10px; padding: 0 6px; border-radius: 99px; background: var(--ok); color: #fff; }
				.pill.down { background: var(--idle); color: var(--muted); text-decoration: line-through; }
				pre { background: var(--soft); border-radius: 8px; padding: 10px; overflow-x: auto; font: 11px/1.6 ui-monospace, monospace; margin: 6px 0 0; }
				@media (max-width: 700px) {
					.win { left: 6px !important; right: 6px; width: auto !important; top: 6px !important; height: calc(100% - 12px) !important; }
					.rz, #bar .hint { display: none; }
				}
			</style>
		</head>
		<body>
			<div id="bar">
				<span class="item"><span class="logo">V</span><span class="app" id="app-name">Vault OS</span></span>
				<span class="item hint">S3-compatible, self-healing object storage</span>
				<span class="spacer"></span>
				<span class="item status" hx-get="/app/pulse" hx-trigger="load, every 2s"><span class="dot idle"></span></span>
				<span class="item">
					<span class="theme" role="group" aria-label="Theme">
						<button data-theme-set="system" title="Match system" aria-label="Match system"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1.5" y="2.5" width="13" height="9" rx="1.5"></rect><path d="M5.5 14h5M8 11.5V14"></path></svg></button>
						<button data-theme-set="light" title="Light" aria-label="Light"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="3"></circle><path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M3 13l1-1M12 4l1-1"></path></svg></button>
						<button data-theme-set="dark" title="Dark" aria-label="Dark"><svg viewBox="0 0 16 16" fill="currentColor"><path d="M13.5 10.2A6 6 0 0 1 5.8 2.5a6 6 0 1 0 7.7 7.7Z"></path></svg></button>
					</span>
				</span>
				<span class="item" id="clock"></span>
			</div>
			<div id="desk"></div>
			<nav id="dock">
				<button class="d-files" data-open="files" data-title="Files" data-url="/app/files" aria-label="Files">
					<span class="ico"><svg viewBox="0 0 24 24" fill="#fff"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.6l2 2h8.4A1.5 1.5 0 0 1 21 8.5V17.5A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5Z" opacity=".95"></path></svg></span><span class="tip">Files</span><span class="run"></span>
				</button>
				<button class="d-stats" data-open="stats" data-title="Stats" data-url="/app/stats" aria-label="Stats">
					<span class="ico"><svg viewBox="0 0 24 24" fill="#fff"><rect x="4" y="12" width="3.5" height="7" rx="1"></rect><rect x="10.25" y="7" width="3.5" height="12" rx="1"></rect><rect x="16.5" y="4" width="3.5" height="15" rx="1"></rect></svg></span><span class="tip">Stats</span><span class="run"></span>
				</button>
				<button class="d-connect" data-open="connect" data-title="Connect" data-url="/app/connect" aria-label="Connect">
					<span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 8 4 4-4 4M12.5 16H18"></path></svg></span><span class="tip">Connect</span><span class="run"></span>
				</button>
				<button class="d-present" data-open="present" data-title="Present" data-url="/app/present?n=0" aria-label="Present">
					<span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3.5" y="4.5" width="17" height="11" rx="1.5"></rect><path d="M12 15.5V20M8.5 20h7"></path></svg></span><span class="tip">Present</span><span class="run"></span>
				</button>
				<span class="sep"></span>
			</nav>
			<div id="ctx" role="menu" hidden></div>
			<div id="toast" role="status" aria-live="polite"></div>
			<template id="win-tpl">
				<div class="win">
					<div class="win-bar">
						<div class="lights">
							<button class="l-close" data-win="close" title="Close" aria-label="Close"><svg viewBox="0 0 8 8"><path d="M1.5 1.5l5 5M6.5 1.5l-5 5"></path></svg></button>
							<button class="l-min" data-win="min" title="Minimize" aria-label="Minimize"><svg viewBox="0 0 8 8"><path d="M1.2 4h5.6"></path></svg></button>
							<button class="l-max" data-win="max" title="Zoom" aria-label="Zoom"><svg viewBox="0 0 8 8"><path d="M2 2h3.2L2 5.2Z M6 6H2.8L6 2.8Z" fill="rgba(0,0,0,.55)" stroke="none"></path></svg></button>
						</div>
						<span class="win-title"></span>
					</div>
					<div class="win-body"></div>
					<span class="rz n" data-rz="n"></span><span class="rz s" data-rz="s"></span><span class="rz e" data-rz="e"></span><span class="rz w" data-rz="w"></span>
					<span class="rz ne" data-rz="ne"></span><span class="rz nw" data-rz="nw"></span><span class="rz se" data-rz="se"></span><span class="rz sw" data-rz="sw"></span>
				</div>
			</template>
			<script>
			(() => {
				const desk = document.getElementById('desk');
				const sizes = { files: [640, 480], stats: [560, 640], connect: [460, 340], present: [880, 600] };
				let z = 10, cascade = 0;

				const dock = document.getElementById('dock');
				const appName = document.getElementById('app-name');
				const wins = () => [...desk.querySelectorAll('.win')];

				const focus = win => {
					wins().forEach(w => w.classList.remove('active'));
					win.style.zIndex = ++z;
					win.classList.add('active');
					appName.textContent = win.dataset.key.startsWith('view:') ? 'Files' : win.dataset.title;
				};
				// After a window closes or minimizes, hand focus to the topmost visible one.
				const refocus = () => {
					const top = wins().filter(w => !w.classList.contains('min')).sort((a, b) => b.style.zIndex - a.style.zIndex)[0];
					if (top) focus(top); else appName.textContent = 'Vault OS';
				};
				// Dock state: a dot under running apps; minimized documents get their own dock tile.
				const syncDock = () => {
					dock.querySelectorAll('button[data-open]').forEach(b => b.classList.toggle('running', wins().some(w => w.dataset.key === b.dataset.open)));
					dock.querySelectorAll('.doc').forEach(d => d.remove());
					for (const w of wins()) {
						if (!w.classList.contains('min') || dock.querySelector(`button[data-open="${CSS.escape(w.dataset.key)}"]:not(.doc)`)) continue;
						const b = document.createElement('button');
						b.className = 'doc';
						b.dataset.restore = w.dataset.key;
						b.innerHTML = '<span class="ico"></span><span class="tip"></span>';
						b.querySelector('.ico').textContent = (w.dataset.title.split('.').pop() || 'doc').slice(0, 4).toUpperCase();
						b.querySelector('.tip').textContent = w.dataset.title;
						dock.appendChild(b);
					}
					dock.querySelector('.sep').style.display = dock.querySelector('.doc') ? 'block' : 'none';
				};

				const restore = win => { win.classList.remove('min'); focus(win); syncDock(); };
				const minimize = win => { win.classList.add('min'); win.classList.remove('active'); refocus(); syncDock(); };
				const toggleMax = win => {
					if (win.classList.toggle('max')) {
						win.dataset.geom = JSON.stringify([win.style.left, win.style.top, win.style.width, win.style.height]);
						Object.assign(win.style, { left: '0px', top: '0px', width: desk.clientWidth + 'px', height: desk.clientHeight + 'px' });
					} else if (win.dataset.geom) {
						const [left, top, width, height] = JSON.parse(win.dataset.geom);
						Object.assign(win.style, { left, top, width, height });
					}
				};
				window.closeWin = el => { el.closest('.win')?.remove(); refocus(); syncDock(); };

				window.openApp = (key, title, url, pos) => {
					let win = wins().find(w => w.dataset.key === key);
					if (win) return restore(win);
					win = document.getElementById('win-tpl').content.firstElementChild.cloneNode(true);
					win.dataset.key = key;
					win.dataset.title = title;
					win.querySelector('.win-title').textContent = title;
					const [w, h] = sizes[key] || [520, 460];
					const off = (cascade++ % 6) * 26;
					Object.assign(win.style, {
						width: Math.min(w, desk.clientWidth - 16) + 'px',
						height: Math.min(h, desk.clientHeight - 16) + 'px',
						left: (pos ? pos[0] : 120 + off) + 'px',
						top: (pos ? pos[1] : 24 + off) + 'px',
					});
					desk.appendChild(win);
					focus(win);
					syncDock();
					const body = win.querySelector('.win-body');
					// Each window is its own request source; sharing <body> makes htmx drop concurrent loads.
					htmx.ajax('GET', url, { source: body, target: body, swap: 'innerHTML' });
				};

				document.addEventListener('click', e => {
					const r = e.target.closest('[data-restore]');
					if (r) { const w = wins().find(w => w.dataset.key === r.dataset.restore); if (w) restore(w); return; }
					const o = e.target.closest('[data-open]');
					if (o) openApp(o.dataset.open, o.dataset.title, o.dataset.url);
					const ctl = e.target.closest('[data-win]');
					if (!ctl) return;
					const win = ctl.closest('.win');
					if (ctl.dataset.win === 'close') closeWin(win);
					if (ctl.dataset.win === 'min') minimize(win);
					if (ctl.dataset.win === 'max') toggleMax(win);
				});
				desk.addEventListener('dblclick', e => {
					if (e.target.closest('.win-bar') && !e.target.closest('button')) toggleMax(e.target.closest('.win'));
				});

				// Pointer drags: move by the title bar, resize from any edge or corner.
				const drag = (e, win, onMove) => {
					e.preventDefault();
					win.classList.add('moving');
					const start = { x: e.clientX, y: e.clientY, l: win.offsetLeft, t: win.offsetTop, w: win.offsetWidth, h: win.offsetHeight };
					const move = m => onMove(m.clientX - start.x, m.clientY - start.y, start);
					const up = () => { win.classList.remove('moving'); removeEventListener('pointermove', move); removeEventListener('pointerup', up); };
					addEventListener('pointermove', move);
					addEventListener('pointerup', up);
				};
				desk.addEventListener('pointerdown', e => {
					const win = e.target.closest('.win');
					if (!win) return;
					focus(win);
					const rz = e.target.closest('[data-rz]');
					if (rz) {
						const d = rz.dataset.rz;
						return drag(e, win, (dx, dy, s) => {
							const minW = 320, minH = 200;
							if (d.includes('e')) win.style.width = Math.max(minW, Math.min(s.w + dx, desk.clientWidth - s.l)) + 'px';
							if (d.includes('s')) win.style.height = Math.max(minH, Math.min(s.h + dy, desk.clientHeight - s.t)) + 'px';
							if (d.includes('w')) { const w = Math.max(minW, s.w - dx); win.style.width = w + 'px'; win.style.left = (s.l + s.w - w) + 'px'; }
							if (d.includes('n')) { const h = Math.max(minH, Math.min(s.h - dy, s.t + s.h)); win.style.height = h + 'px'; win.style.top = (s.t + s.h - h) + 'px'; }
						});
					}
					if (!e.target.closest('.win-bar') || e.target.closest('button')) return;
					drag(e, win, (dx, dy, s) => {
						if (win.classList.contains('max')) return;
						win.style.left = Math.max(-s.w + 100, Math.min(s.l + dx, desk.clientWidth - 100)) + 'px';
						win.style.top = Math.max(0, Math.min(s.t + dy, desk.clientHeight - 38)) + 'px';
					});
				});
				addEventListener('resize', () => wins().filter(w => w.classList.contains('max')).forEach(w => Object.assign(w.style, { width: desk.clientWidth + 'px', height: desk.clientHeight + 'px' })));

				// Upload: pick with the button, or drop files anywhere on a Files window.
				const submitFiles = (files, zone) => {
					const form = zone.querySelector('.upload-form');
					if (!form || !files.length) return;
					const input = form.querySelector('input[type=file]');
					if (input.files !== files) input.files = files;
					htmx.trigger(form, 'submit');
				};
				document.addEventListener('change', e => {
					if (e.target.matches('.upload-form input[type=file]')) submitFiles(e.target.files, e.target.closest('.files'));
				});
				document.addEventListener('dragover', e => {
					const zone = e.target.closest('.files');
					e.preventDefault();
					document.querySelectorAll('.files.over').forEach(f => f !== zone && f.classList.remove('over'));
					zone?.classList.add('over');
				});
				document.addEventListener('dragleave', e => { if (!e.relatedTarget) document.querySelectorAll('.files.over').forEach(f => f.classList.remove('over')); });
				document.addEventListener('drop', e => {
					e.preventDefault();
					const zone = e.target.closest('.files');
					document.querySelectorAll('.files.over').forEach(f => f.classList.remove('over'));
					if (zone) submitFiles(e.dataTransfer.files, zone);
				});
				document.body.addEventListener('htmx:xhr:progress', e => {
					const p = e.target.querySelector?.('progress');
					if (p && e.detail.lengthComputable) p.value = e.detail.loaded / e.detail.total;
				});

				// Theme: System follows the OS; Light/Dark are remembered in this browser.
				const applyTheme = t => {
					if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
					else delete document.documentElement.dataset.theme;
					document.querySelectorAll('[data-theme-set]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.themeSet === (t || 'system'))));
				};
				let saved = 'system';
				try { saved = localStorage.getItem('vault-theme') || 'system'; } catch {}
				applyTheme(saved);
				document.addEventListener('click', e => {
					const b = e.target.closest('[data-theme-set]');
					if (!b) return;
					applyTheme(b.dataset.themeSet);
					try { localStorage.setItem('vault-theme', b.dataset.themeSet); } catch {}
				});

				// Present: arrow keys / space step through slides; F toggles fullscreen.
				document.addEventListener('keydown', e => {
					const win = desk.querySelector('.win.active[data-key="present"]');
					if (!win || e.target.closest?.('input, select, textarea')) return;
					const go = sel => { const b = win.querySelector(sel); if (b) { e.preventDefault(); b.click(); } };
					if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') go('[data-nav="next"]');
					if (e.key === 'ArrowLeft' || e.key === 'PageUp') go('[data-nav="prev"]');
					if (e.key === 'f') toggleFull(win);
				});
				window.toggleFull = el => {
					const win = el.closest('.win');
					if (document.fullscreenElement) document.exitFullscreen(); else win.requestFullscreen?.();
				};
				document.addEventListener('click', e => {
					const c = e.target.closest('[data-copy]');
					if (!c) return;
					navigator.clipboard?.writeText(c.dataset.copy);
					c.textContent = 'Copied';
					setTimeout(() => c.textContent = 'Copy', 1200);
				});

				const clock = document.getElementById('clock');
				const tick = () => { const d = new Date(); clock.textContent = d.toLocaleDateString([], { weekday: 'short', day: 'numeric', month: 'short' }) + '  ' + d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); };
				tick(); setInterval(tick, 10000);

				// ---- Right-click menus ----
				const ctx = document.getElementById('ctx');
				const toast = msg => { const t = document.getElementById('toast'); t.textContent = msg; t.classList.add('show'); clearTimeout(t._h); t._h = setTimeout(() => t.classList.remove('show'), 1800); };
				const copy = (text, what) => navigator.clipboard?.writeText(text).then(() => toast(what + ' copied'), () => toast('Copy failed'));
				const post = async (url, done) => {
					const r = await fetch(url, { method: 'POST' });
					const body = await r.text();
					if (!r.ok || body.includes('class="err"')) { toast((body.match(/class="err">([^<]*)/)?.[1] || body || r.statusText).slice(0, 120)); return false; }
					if (done) toast(done);
					return true;
				};
				const changed = () => htmx.trigger(document.body, 'vault:changed');
				const q = encodeURIComponent;
				const s3uri = (b, k = '') => `s3://${b}/${k}`;
				const apps = [['files', 'Files', '/app/files'], ['stats', 'Stats', '/app/stats'], ['connect', 'Connect', '/app/connect'], ['present', 'Present', '/app/present?n=0']];

				const menuFor = e => {
					const t = e.target;
					const el = t.closest('[data-ctx]');
					const win = t.closest('.win');
					if (el?.dataset.ctx === 'file') {
						const { bucket, key, dl } = el.dataset;
						return [{ head: key },
							{ label: 'Open', act: () => el.click() },
							{ label: 'Download', act: () => { const a = document.createElement('a'); a.href = dl; a.download = key.split('/').pop(); a.click(); } },
							{ sep: 1 },
							{ label: 'Copy S3 URI', act: () => copy(s3uri(bucket, key), 'S3 URI') },
							{ label: 'Copy link', act: () => copy(location.origin + dl, 'Link') },
							{ label: 'Show where it\u2019s stored', act: () => {
								el.click();
								const w = wins().find(w => w.dataset.key === el.dataset.open);
								w?.querySelector('.win-body').addEventListener('htmx:afterSettle', () => w.querySelector('.viewer h3')?.scrollIntoView({ behavior: 'smooth' }), { once: true });
							} },
							{ sep: 1 },
							{ label: 'Delete', danger: 1, act: async () => {
								if (!confirm(`Delete \u201c${key}\u201d?`)) return;
								if (await post(`/app/files/delete?bucket=${q(bucket)}&key=${q(key)}`, 'Deleted ' + key.split('/').pop())) {
									wins().find(w => w.dataset.key === el.dataset.open)?.remove();
									changed(); syncDock();
								}
							} }];
					}
					if (el?.dataset.ctx === 'folder') {
						return [{ head: el.dataset.prefix },
							{ label: 'Open', act: () => el.click() },
							{ label: 'Copy S3 URI', act: () => copy(s3uri(el.dataset.bucket, el.dataset.prefix), 'S3 URI') }];
					}
					if (el?.dataset.ctx === 'bucket') {
						const b = el.dataset.bucket;
						return [{ head: 'Bucket ' + b },
							{ label: 'Open', act: () => el.click() },
							{ label: 'Copy S3 URI', act: () => copy(s3uri(b), 'S3 URI') },
							{ sep: 1 },
							{ label: 'Delete bucket', danger: 1, act: async () => {
								if (!confirm(`Delete bucket \u201c${b}\u201d? It must be empty.`)) return;
								if (await post(`/app/files/dropbucket?bucket=${q(b)}`, 'Deleted bucket ' + b)) changed();
							} }];
					}
					if (el?.dataset.ctx === 'node') {
						const { node: id, alive, slow, cutMeta } = el.dataset;
						const act = (a, msg) => () => post(`/ui/nodes/${id}/${a}`, msg);
						return [{ head: 'Storage node ' + id },
							alive === 'true' ? { label: 'Kill', danger: 1, act: act('kill', id + ' killed') } : { label: 'Revive', act: act('revive', id + ' revived') },
							{ label: 'Corrupt a chunk', act: act('corrupt', 'Flipped a byte on ' + id) },
							{ label: slow === 'true' ? 'Make fast again' : 'Make slow', act: act('slow', slow === 'true' ? id + ' is fast' : id + ' is slow') },
							{ label: cutMeta === 'true' ? 'Restore link to metadata' : 'Cut link to metadata', act: act('partition?peer=meta', 'Link toggled') }];
					}
					if (el?.dataset.ctx === 'files') {
						const form = el.querySelector('.upload-form');
						const input = el.querySelector('input[name=name]');
						return [{ head: el.dataset.bucket ? s3uri(el.dataset.bucket, el.dataset.prefix) : 'Buckets' },
							form && { label: 'Upload files\u2026', act: () => form.querySelector('input[type=file]').click() },
							input && { label: 'New bucket\u2026', act: () => input.focus() },
							el.dataset.bucket && { label: 'Copy S3 URI', act: () => copy(s3uri(el.dataset.bucket, el.dataset.prefix), 'S3 URI') },
							{ label: 'Refresh', act: () => htmx.ajax('GET', el.getAttribute('hx-get'), { source: el, target: el, swap: 'outerHTML' }) }];
					}
					if (win && t.closest('.win-bar')) {
						return [{ head: win.dataset.title },
							{ label: 'Minimize', act: () => minimize(win) },
							{ label: win.classList.contains('max') ? 'Restore size' : 'Zoom', act: () => toggleMax(win) },
							{ sep: 1 },
							{ label: 'Close', act: () => closeWin(win) },
							{ label: 'Close other windows', act: () => { wins().filter(w => w !== win).forEach(w => w.remove()); syncDock(); } }];
					}
					const dockBtn = t.closest('#dock button');
					if (dockBtn) {
						const key = dockBtn.dataset.open || dockBtn.dataset.restore;
						const w = wins().find(w => w.dataset.key === key);
						const title = dockBtn.dataset.title || w?.dataset.title;
						if (!w) return [{ head: title }, { label: 'Open', act: () => dockBtn.click() }];
						return [{ head: title },
							{ label: 'Show', act: () => restore(w) },
							!w.classList.contains('min') && { label: 'Minimize', act: () => minimize(w) },
							{ sep: 1 },
							{ label: 'Quit', act: () => closeWin(w) }];
					}
					if (!win) {
						const theme = document.documentElement.dataset.theme || 'system';
						const setTheme = v => () => { applyTheme(v); try { localStorage.setItem('vault-theme', v); } catch {} };
						return [{ head: 'Vault OS' },
							...apps.map(([k, title, url]) => ({ label: 'Open ' + title, act: () => openApp(k, title, url) })),
							{ sep: 1 },
							{ head: 'Appearance' },
							{ label: 'System', check: theme === 'system', act: setTheme('system') },
							{ label: 'Light', check: theme === 'light', act: setTheme('light') },
							{ label: 'Dark', check: theme === 'dark', act: setTheme('dark') },
							{ sep: 1 },
							{ label: 'Show all windows', act: () => wins().forEach(w => w.classList.remove('min')) || syncDock() },
							{ label: 'Minimize all', act: () => wins().forEach(minimize) },
							{ label: 'Close all windows', act: () => { wins().forEach(w => w.remove()); refocus(); syncDock(); } }];
					}
					return null; // inside window content: keep the browser's own menu
				};

				const hideMenu = () => { ctx.hidden = true; ctx.replaceChildren(); };
				document.addEventListener('contextmenu', e => {
					if (e.target.closest?.('input, textarea, select, #ctx')) return;
					const items = menuFor(e)?.filter(Boolean);
					if (!items) return hideMenu();
					e.preventDefault();
					ctx.replaceChildren(...items.map(it => {
						if (it.sep) return document.createElement('hr');
						if (it.head) { const h = document.createElement('div'); h.className = 'h'; h.textContent = it.head; return h; }
						const b = document.createElement('button');
						b.setAttribute('role', 'menuitem');
						if (it.danger) b.className = 'danger';
						b.innerHTML = '<span class="chk"></span><span></span>';
						b.firstChild.textContent = it.check ? '\u2713' : '';
						b.lastChild.textContent = it.label;
						b.onclick = () => { hideMenu(); it.act(); };
						return b;
					}));
					ctx.hidden = false;
					const { innerWidth: vw, innerHeight: vh } = window;
					ctx.style.left = Math.min(e.clientX, vw - ctx.offsetWidth - 6) + 'px';
					ctx.style.top = Math.min(e.clientY, vh - ctx.offsetHeight - 6) + 'px';
					ctx.querySelector('button')?.focus({ preventScroll: true });
				});
				addEventListener('pointerdown', e => { if (!ctx.hidden && !e.target.closest?.('#ctx')) hideMenu(); }, true);
				addEventListener('keydown', e => {
					if (ctx.hidden) return;
					e.stopPropagation(); // keys drive the menu, not the window behind it
					const items = [...ctx.querySelectorAll('button')];
					const i = items.indexOf(document.activeElement);
					if (e.key === 'Escape') hideMenu();
					if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length]?.focus(); }
					if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length]?.focus(); }
				}, true);
				addEventListener('blur', hideMenu);
				addEventListener('resize', hideMenu);

				// Start with the two apps that tell the story side by side.
				const half = desk.clientWidth / 2;
				openApp('files', 'Files', '/app/files', desk.clientWidth > 1100 ? [Math.max(16, half - 660), 24] : null);
				openApp('stats', 'Stats', '/app/stats', desk.clientWidth > 1100 ? [half, 24] : null);
			})();
			</script>
		</body>
	</html>
}

templ Pulse(c Cluster) {
	{{ label, class := c.Health() }}
	<span class={ "dot", class }></span>{ label } <span class="muted">· { c.AliveNodes() }</span>
}

// ---- Files ----

templ FilesApp(f Files) {
	<div class="files" data-ctx="files" data-bucket={ f.Bucket } data-prefix={ f.Prefix } hx-get={ f.URL() } hx-trigger="vault:changed from:body" hx-swap="outerHTML">
		<div class="toolbar">
			for i, c := range f.Crumbs() {
				if i > 0 {
					<span class="sep">/</span>
				}
				<button class="crumb" hx-get={ c.URL } hx-target="closest .files" hx-swap="outerHTML">{ c.Name }</button>
			}
			<span style="flex:1"></span>
			if f.Bucket != "" {
				<span class="muted">{ f.Policy }</span>
				<form class="upload-form" hx-post={ "/app/files/upload?bucket=" + urlq(f.Bucket) + "&prefix=" + urlq(f.Prefix) } hx-encoding="multipart/form-data" hx-target="closest .files" hx-swap="outerHTML">
					<label class="btn dark">Upload<input type="file" name="files" multiple hidden/></label>
					<progress max="1" value="0"></progress>
				</form>
			}
		</div>
		if f.Err != "" {
			<p class="err">{ f.Err }</p>
		}
		if f.Bucket == "" {
			<div class="grid">
				for _, b := range f.Buckets {
					<button class="tile" data-ctx="bucket" data-bucket={ b.Name } hx-get={ FilesURL(b.Name, "") } hx-target="closest .files" hx-swap="outerHTML">
						<div class="folder bucket"></div>
						<div class="name">{ b.Name }</div>
						<div class="sub">{ b.Policy }</div>
					</button>
				}
			</div>
			<form class="row" hx-post="/app/files/bucket" hx-target="closest .files" hx-swap="outerHTML" style="margin-top:auto">
				<input type="text" name="name" placeholder="new-bucket" required pattern="[a-z0-9][a-z0-9.\-]{1,61}[a-z0-9]"/>
				<select name="policy">
					<option value="3/2">3 copies · 2 acks</option>
					<option value="2/1">2 copies · 1 ack</option>
					<option value="1/1">1 copy · no redundancy</option>
					<option value="5/3">5 copies · 3 acks</option>
				</select>
				<button class="btn" type="submit">Create bucket</button>
			</form>
		} else if len(f.Folders) == 0 && len(f.Objects) == 0 {
			<div class="empty">
				<div>
					Drop any files here, or use Upload.
					<br/>
					if f.Prefix == "" {
						<button class="btn red" style="margin-top:12px" hx-post={ "/app/files/dropbucket?bucket=" + urlq(f.Bucket) } hx-target="closest .files" hx-swap="outerHTML">Delete empty bucket</button>
					}
				</div>
			</div>
		} else {
			<div class="grid">
				for _, p := range f.Folders {
					<button class="tile" data-ctx="folder" data-bucket={ f.Bucket } data-prefix={ p } hx-get={ FilesURL(f.Bucket, p) } hx-target="closest .files" hx-swap="outerHTML">
						<div class="folder"></div>
						<div class="name">{ FolderName(p) }</div>
					</button>
				}
				for _, o := range f.Objects {
					<button class="tile" data-ctx="file" data-bucket={ o.Bucket } data-key={ o.Key } data-dl={ o.URL() } data-open={ "view:" + o.Bucket + "/" + o.Key } data-title={ o.Name } data-url={ o.ViewURL() } title={ o.Key }>
						if o.Kind() == "image" {
							<img class="thumb" src={ o.URL() } alt="" loading="lazy"/>
						} else {
							<div class="badge">{ o.Ext() }</div>
						}
						<div class="name">{ o.Name }</div>
						<div class="sub">{ o.Size }</div>
					</button>
				}
			</div>
		}
	</div>
}

// ---- Viewer ----

templ ViewerApp(v Viewer) {
	<div class="viewer">
		<div class="preview">
			switch v.Kind() {
				case "image":
					<img src={ v.URL() } alt={ v.Name }/>
				case "video":
					<video src={ v.URL() } controls></video>
				case "audio":
					<audio src={ v.URL() } controls></audio>
				case "doc":
					<iframe src={ v.URL() } title={ v.Name }></iframe>
				default:
					<p class="muted">No preview for { v.Type }</p>
			}
		</div>
		<table class="kv">
			<tr><td>Name</td><td>{ v.Key }</td></tr>
			<tr><td>Bucket</td><td>{ v.Bucket }</td></tr>
			<tr><td>Type</td><td>{ v.Type }</td></tr>
			<tr><td>Size</td><td>{ v.Size }</td></tr>
			<tr><td>Modified</td><td>{ v.Modified }</td></tr>
			<tr><td>ETag</td><td class="mono">{ v.ETag }</td></tr>
		</table>
		<div class="row">
			<a class="btn" href={ templ.URL(v.URL()) } download={ v.Name }>Download</a>
			<button class="btn red" hx-post={ "/app/files/delete?bucket=" + urlq(v.Bucket) + "&key=" + urlq(v.Key) } hx-confirm="Delete this object?" hx-swap="none" hx-on--after-request="if (event.detail.successful) closeWin(this)">Delete</button>
		</div>
		<div>
			<h3>Where the bytes live · { fmt.Sprint(len(v.Chunks)) } chunks</h3>
			for _, c := range v.Chunks {
				<div class="chunk">
					<span class="muted">#{ fmt.Sprint(c.N) }</span>
					<code title={ c.SHA }>{ c.SHA[:12] }</code>
					<span class="muted">{ c.Size }</span>
					<span style="flex:1"></span>
					for _, h := range c.Holders {
						<span class={ "pill", templ.KV("down", !h.Alive) }>{ h.ID }</span>
					}
				</div>
			}
		</div>
	</div>
}

// ---- Stats ----

templ StatsApp() {
	<div hx-get="/app/stats/live" hx-trigger="load, every 1s" hx-swap="innerHTML"></div>
}

templ StatsLive(c Cluster) {
	{{ label, class := c.Health() }}
	<div class="health"><span class={ "dot", class }></span>{ label }</div>
	if c.Err != "" {
		<p class="err">{ c.Err }</p>
	}
	<div class="stats">
		<div class="stat"><b>{ fmt.Sprint(c.Objects) }</b><span>objects</span></div>
		<div class="stat"><b>{ c.Logical }</b><span>stored</span></div>
		<div class="stat"><b>{ c.Raw }</b><span>on disk</span></div>
		<div class="stat"><b>{ c.Overhead }</b><span>overhead</span></div>
		<div class="stat"><b>{ fmt.Sprint(c.TotalChunks) }</b><span>chunks</span></div>
		<div class="stat"><b>{ fmt.Sprint(c.Under) }</b><span>under-replicated</span></div>
		<div class="stat"><b>{ fmt.Sprint(c.Repairs) }</b><span>repairs</span></div>
		<div class="stat"><b>{ c.MTTR }</b><span>last repair time</span></div>
	</div>
	<h3>Storage nodes · { c.AliveNodes() }</h3>
	<div class="nodes">
		for _, n := range c.Nodes {
			<div class={ "node", templ.KV("dead", !n.Alive) } data-ctx="node" data-node={ n.ID } data-alive={ fmt.Sprint(n.Alive) } data-slow={ fmt.Sprint(n.SlowMs > 0) } data-cut-meta={ fmt.Sprint(n.PartitionedFrom("meta")) }>
				<div>
					if n.Alive {
						<span class={ "dot", templ.KV("warn", len(n.Partitioned) > 0 || n.SlowMs > 0) }></span>
					} else {
						<span class="dot bad"></span>
					}
					<span class="id">{ n.ID }</span>
					<span class="muted">· zone { n.Zone } · { fmt.Sprint(n.Chunks) } chunks · { n.Used }</span>
					if n.Down {
						<span class="muted">· killed</span>
					} else if !n.Alive {
						<span class="muted">· unreachable</span>
					}
				</div>
				<div class="row" style="gap:4px">
					if n.Down || !n.Alive {
						<button class="btn xs" hx-post={ "/ui/nodes/" + n.ID + "/revive" } hx-swap="none" title="Clears an injected kill; a crashed process must be restarted">Revive</button>
					} else {
						<button class="btn xs red" hx-post={ "/ui/nodes/" + n.ID + "/kill" } hx-swap="none">Kill</button>
					}
					<button class="btn xs" hx-post={ "/ui/nodes/" + n.ID + "/corrupt" } hx-swap="none">Corrupt</button>
					<button class={ "btn xs", templ.KV("on", n.SlowMs > 0) } hx-post={ "/ui/nodes/" + n.ID + "/slow" } hx-swap="none">Slow</button>
				</div>
				<div class="chips">
					<span class="muted">cut link to</span>
					for _, p := range n.Peers {
						<button class={ "btn xs", templ.KV("on", n.PartitionedFrom(p)) } hx-post={ "/ui/nodes/" + n.ID + "/partition?peer=" + p } hx-swap="none">{ p }</button>
					}
				</div>
			</div>
		}
	</div>
	<h3>Metadata · Raft</h3>
	<div class="row">
		for _, r := range c.Raft {
			if r.Up {
				<span><span class={ "dot", templ.KV("idle", r.State != "Leader") }></span>{ r.ID } <span class="muted">{ r.State } · t{ fmt.Sprint(r.Term) }</span></span>
			} else {
				<span><span class="dot bad"></span>{ r.ID } <span class="muted">down</span></span>
			}
		}
		<span style="flex:1"></span>
		<button class="btn xs" hx-post="/ui/meta/stepdown" hx-swap="none">Force election</button>
	</div>
	<h3>Chunk placement</h3>
	<div class="heat">
		<div class="hhead">
			<i></i>
			for _, n := range c.Nodes {
				<span>{ n.ID }</span>
			}
		</div>
		for _, r := range c.Rows {
			<div class={ "hrow", r.State }>
				<code>{ r.SHA[:10] }</code>
				for _, cell := range r.Cells {
					<div class={ "cell", cell }></div>
				}
			</div>
		}
	</div>
	if c.MoreChunks > 0 {
		<p class="muted">+ { fmt.Sprint(c.MoreChunks) } more chunks</p>
	}
	if len(c.Rows) == 0 {
		<p class="muted">No chunks yet. Upload something in Files.</p>
	}
}

// ---- Connect ----

templ ConnectApp(endpoint, accessKey string) {
	<p>Vault speaks the S3 API. Point any S3 tool at it:</p>
	<pre>{ "export AWS_ENDPOINT_URL=http://" + endpoint + "\nexport AWS_ACCESS_KEY_ID=" + accessKey + "\nexport AWS_SECRET_ACCESS_KEY=$VAULT_SECRET_KEY\nexport AWS_DEFAULT_REGION=us-east-1" }</pre>
	<pre>{ "aws s3 mb s3://photos\naws s3 sync ./pics s3://photos/\naws s3 ls s3://photos/\naws s3 cp s3://photos/cat.jpg ." }</pre>
	<p class="muted">Uploads from the CLI show up in Files; every write lands on 3 nodes in different zones.</p>
}

// ---- Present ----

templ PresentApp(d Deck) {
	<div class="deck">
		<div class={ "slide", templ.KV("cover", d.Kind == "cover") }>
			switch d.Kind {
				case "cover":
					@coverSlide()
				case "problem":
					<span class="kicker">The brief</span>
					<h1>{ d.Title }</h1>
					<blockquote>
						for _, p := range ProblemStatement {
							<p>{ p }</p>
						}
					</blockquote>
				case "requirements":
					<span class="kicker">Every clause, answered</span>
					<h1>{ d.Title }</h1>
					<div class="req">
						for _, r := range Requirements {
							<div>{ r.Need }</div>
							<div>{ r.How }</div>
						}
					</div>
				case "architecture":
					@archSlide()
				case "dataflow":
					@dataflowSlide()
				case "healing":
					@healingSlide()
				case "durability":
					@durabilitySlide()
				case "step":
					<span class="kicker">{ d.DemoLabel() }</span>
					<h1>{ d.Title }</h1>
					<div class="say">
						for _, line := range d.Step.Say {
							<p style="margin:0">{ line }</p>
						}
					</div>
					if len(d.Step.Actions) > 0 {
						<div class="row">
							for _, a := range d.Step.Actions {
								<button class={ "btn", templ.KV("red", a.Danger), templ.KV("dark", !a.Danger) } hx-post={ a.Post } hx-target="#deck-out" hx-swap="innerHTML">{ a.Label }</button>
							}
							<span id="deck-out"></span>
						</div>
					}
					for _, c := range d.Step.Cmds {
						<div class="cmd">
							<pre>{ c }</pre>
							<button class="btn xs" data-copy={ c }>Copy</button>
						</div>
					}
					if d.Step.Watch != "" {
						<div class="watch"><b>Watch:</b> { d.Step.Watch }</div>
					}
			}
		</div>
		<div class="deck-nav">
			<button class="btn" data-nav="prev" hx-get={ d.URL(d.N - 1) } hx-target="closest .deck" hx-swap="outerHTML" disabled?={ !d.HasPrev() }>← Prev</button>
			<div class="bar"><i style={ fmt.Sprintf("width:%d%%", (d.N+1)*100/d.Total) }></i></div>
			<span class="muted">{ d.Progress() }</span>
			<button class="btn" onclick="toggleFull(this)" title="Fullscreen (F)">⤢</button>
			<button class="btn dark" data-nav="next" hx-get={ d.URL(d.N + 1) } hx-target="closest .deck" hx-swap="outerHTML" disabled?={ !d.HasNext() }>Next →</button>
		</div>
	</div>
}

templ coverSlide() {
	<div style="display:contents">
		<span class="kicker">Hackathon · distributed systems</span>
		<h1>Vault</h1>
		<p style="font-size:18px;margin:0;max-width:34em">Fault-tolerant, self-healing object storage that speaks S3, built in Go.</p>
		<div class="tags">
			<span class="tag">S3 API + SigV4</span>
			<span class="tag">Raft metadata</span>
			<span class="tag">SHA-256 chunks</span>
			<span class="tag">zone-aware replication</span>
			<span class="tag">automatic repair</span>
		</div>
		<p class="muted" style="margin:0">Use ← → to move, F for fullscreen.</p>
	</div>
}

templ archSlide() {
	<span class="kicker">Three roles, one binary</span>
	<h1>Architecture</h1>
	<div class="arch">
		<div class="tier"><span>Clients</span><div class="boxes"><div class="box">aws CLI</div><div class="box">boto3 / SDKs</div><div class="box">rclone</div><div class="box">Vault OS</div></div></div>
		<div class="arrow">↓ S3 over HTTP, SigV4-signed</div>
		<div class="tier"><span>Gateways</span><div class="boxes"><div class="box strong">gateway</div><div class="box strong">gateway</div><div class="box">… stateless, scale out</div></div></div>
		<div class="arrow">↓ gRPC: metadata to the Raft leader, bytes straight to nodes</div>
		<div class="tier"><span>Metadata</span><div class="boxes"><div class="box strong">m1 · leader</div><div class="box">m2</div><div class="box">m3</div><div class="box">Raft: buckets, manifests, chunk locations</div></div></div>
		<div class="tier"><span>Storage</span><div class="boxes"><div class="box">zone 1: n1 n4</div><div class="box">zone 2: n2 n5</div><div class="box">zone 3: n3</div><div class="box">… add nodes anytime</div></div></div>
	</div>
	<p class="muted" style="margin:0">Bytes never pass through metadata, so metadata load is one Raft entry per object, not per byte.</p>
}

templ dataflowSlide() {
	<span class="kicker">Write once, verify always</span>
	<h1>How bytes move</h1>
	<div class="cols">
		<div>
			<h2>Write</h2>
			<ol>
				<li>Gateway checks the SigV4 signature and body checksums.</li>
				<li>Cuts the stream into 4 MB chunks; names each by its SHA-256.</li>
				<li>Sends each chunk to 3 nodes in different zones, in parallel.</li>
				<li>Waits for W acknowledgements (default 2).</li>
				<li>Commits the manifest through Raft, then answers 200.</li>
			</ol>
		</div>
		<div>
			<h2>Read</h2>
			<ol>
				<li>Fetch the manifest from the Raft leader.</li>
				<li>For each chunk, try a live holder; re-hash every byte.</li>
				<li>Dead, slow or corrupt copy? Use the next one and report it.</li>
				<li>Range requests only touch the chunks they need.</li>
			</ol>
		</div>
	</div>
}

templ healingSlide() {
	<span class="kicker">No human in the loop</span>
	<h1>Self-healing</h1>
	<div class="cols">
		<ul>
			<li><b>Detect</b>: nodes heartbeat every second; silent for 3 s means dead.</li>
			<li><b>Repair</b>: under-replicated chunks are copied node-to-node from any healthy holder, 16 at a time.</li>
			<li><b>Scrub</b>: every node re-hashes its data at rest and quarantines anything that rotted.</li>
		</ul>
		<ul>
			<li><b>Rebalance</b>: new nodes get their share; extra copies are trimmed after a node returns.</li>
			<li><b>Collect</b>: unreferenced chunks are deleted, with tombstones so GC never races an upload.</li>
			<li><b>Measure</b>: time from failure to full redundancy is shown live in Stats.</li>
		</ul>
	</div>
}

templ durabilitySlide() {
	<span class="kicker">Predictable availability, chosen per bucket</span>
	<h1>Durability is a choice</h1>
	<table class="grid-t">
		<tr><th>Policy (copies / acks)</th><th>Storage overhead</th><th>Survives losing</th><th>Good for</th></tr>
		<tr><td>1 / 1</td><td>1×</td><td>nothing</td><td>scratch, caches</td></tr>
		<tr><td>2 / 1</td><td>2×</td><td>1 node</td><td>re-creatable data</td></tr>
		<tr><td><b>3 / 2 (default)</b></td><td>3×</td><td>2 nodes</td><td>most data</td></tr>
		<tr><td>5 / 3</td><td>5×</td><td>4 nodes</td><td>critical records</td></tr>
	</table>
	<p style="margin:0">Overhead drops further with dedup: identical content is stored once, and server-side copies are metadata-only.</p>
	<p class="muted" style="margin:0">Next: erasure coding (4+2 = 1.5× overhead) and sharding metadata across several Raft groups.</p>
}
