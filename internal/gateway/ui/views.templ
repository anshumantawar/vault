package ui

import "fmt"

// pageHead is the shared <head>: theme, htmx and every style.
templ pageHead(title string) {
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<title>{ title }</title>
			<link rel="icon" href="/static/logo.svg" type="image/svg+xml"/>
			<script>
				// Apply the saved theme before first paint, so there's no flash.
				try { const t = localStorage.getItem('vault-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
			</script>
			<script src="/static/htmx.min.js"></script>
			<style>
				:root {
					color-scheme: light dark;
					--bg: #eceae6; --win: #fbfaf8; --text: #1c1b19; --muted: #7a766f; --line: #dedad3; --soft: #f1efeb;
					--ok: #2f9e5b; --warn: #d4870b; --bad: #d64534; --idle: #d7d3cc; --accent: #1c1b19;
					--shadow: 0 1px 2px rgba(0,0,0,.06), 0 12px 32px rgba(0,0,0,.10);
					--wallpaper: url(/static/wallpaper-light.svg);
				}
				:root[data-theme="light"] { color-scheme: light; }
				@media (prefers-color-scheme: dark) {
					:root:not([data-theme="light"]) {
						--wallpaper: url(/static/wallpaper-dark.svg);
						--bg: #121212; --win: #1c1c1c; --text: #ecebe8; --muted: #8d8a84; --line: #2c2c2c; --soft: #242424;
						--ok: #46c07a; --warn: #f0a531; --bad: #f0634f; --idle: #333; --accent: #ecebe8;
						--shadow: 0 1px 2px rgba(0,0,0,.4), 0 16px 40px rgba(0,0,0,.5);
					}
				}
				:root[data-theme="dark"] {
					color-scheme: dark;
					--wallpaper: url(/static/wallpaper-dark.svg);
					--bg: #121212; --win: #1c1c1c; --text: #ecebe8; --muted: #8d8a84; --line: #2c2c2c; --soft: #242424;
					--ok: #46c07a; --warn: #f0a531; --bad: #f0634f; --idle: #333; --accent: #ecebe8;
					--shadow: 0 1px 2px rgba(0,0,0,.4), 0 16px 40px rgba(0,0,0,.5);
				}
				:root { --c-p1: #2a78d6; --c-p2: #eb6834; --c-p3: #1baf7a; }
				@media (prefers-color-scheme: dark) { :root:not([data-theme="light"]) { --c-p1: #3987e5; --c-p2: #d95926; --c-p3: #199e70; } }
				:root[data-theme="dark"] { --c-p1: #3987e5; --c-p2: #d95926; --c-p3: #199e70; }
				.win-body:has(> .deck) { container-type: inline-size; }
				.deck { height: 100%; display: flex; flex-direction: column; gap: 12px; }
				.slide { flex: 1; overflow: auto; display: flex; flex-direction: column; gap: 12px; padding: 2px 4px; }
				.slide .kicker { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .1em; color: var(--muted); }
				.slide h1 { font-size: 28px; line-height: 1.15; margin: -6px 0 0; letter-spacing: -.02em; }
				.slide .lead { font-size: 15px; line-height: 1.5; margin: 0; max-width: 46em; }
				.slide p, .slide li { font-size: 14px; line-height: 1.5; }
				.s-cover { justify-content: center; }
				.cover-in { display: grid; gap: 12px; justify-items: start; }
				.cover-in .big { font-size: 64px; letter-spacing: -.035em; margin: 0; line-height: 1; }
				.cover-in .tagline { font-size: 22px; font-weight: 600; margin: 0; }
				.cover-in .blurb { margin: 0; max-width: 34em; color: var(--muted); font-size: 15px; }
				.cover-in .hint { margin: 8px 0 0; color: var(--muted); font-size: 12px; }
				.tags { display: flex; gap: 6px; flex-wrap: wrap; }
				.tag { border: 1px solid var(--line); border-radius: 99px; padding: 2px 10px; font-size: 12px; color: var(--muted); }
				blockquote { margin: 0; padding: 2px 0 2px 16px; border-left: 3px solid var(--text); display: grid; gap: 10px; }
				blockquote p { margin: 0; font-size: 15px !important; }
				.plain { margin: 0; padding: 12px 14px; border-radius: 10px; background: var(--soft); font-size: 15px !important; }
				.acts { display: flex; gap: 8px; flex-wrap: wrap; }
				.acts .btn { font-size: 13px; padding: 6px 14px; border-radius: 8px; }
				.acts .btn.htmx-request { opacity: .55; cursor: progress; }
				.out:not(:empty) { font-size: 13px; padding: 10px 12px; border-radius: 10px; background: var(--soft); line-height: 1.5; }
				.pc { display: inline-grid; place-items: center; width: 26px; height: 26px; border-radius: 6px; color: #fff; font-weight: 700; font-size: 12px; flex: none; }
				.pc.p1 { background: var(--c-p1); } .pc.p2 { background: var(--c-p2); } .pc.p3 { background: var(--c-p3); }
				.idea { display: flex; align-items: stretch; gap: 10px; flex-wrap: wrap; }
				.i-card { border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; display: grid; gap: 8px; justify-items: center; align-content: center; text-align: center; }
				.i-card small { color: var(--muted); font-size: 12px; max-width: 15em; line-height: 1.4; }
				.i-card .row { justify-content: center; gap: 5px; }
				.doc { width: 40px; height: 50px; border-radius: 6px; background: var(--soft); border: 1px solid var(--line); display: grid; place-items: end center; padding-bottom: 6px; font-size: 9px; font-weight: 700; color: var(--muted); }
				.arrow { align-self: center; font-size: 20px; color: var(--muted); }
				.zone { border: 1px dashed var(--muted); border-radius: 10px; padding: 6px 8px; display: grid; gap: 5px; justify-items: center; }
				.zone b { font-size: 11px; color: var(--muted); font-weight: 600; }
				.sample { display: grid; gap: 6px; }
				.srow { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
				.chip { display: inline-flex; align-items: center; gap: 4px; border: 1px solid var(--line); border-radius: 99px; padding: 1px 8px 1px 6px; font-size: 12px; background: var(--win); }
				.chip small { color: var(--muted); }
				.chip .dot { margin-right: 0; }
				.chip.down { color: var(--muted); }
				.arch2 { display: grid; gap: 8px; }
				.tier { display: grid; grid-template-columns: 124px 1fr; gap: 4px 12px; align-items: center; }
				.tl { font-weight: 600; font-size: 13px; } .tl small { display: block; font-weight: 400; color: var(--muted); font-size: 11px; }
				.tb { display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
				.box { border: 1px solid var(--line); background: var(--soft); border-radius: 8px; padding: 5px 10px; font-size: 12px; }
				.box.strong { background: var(--text); color: var(--win); border-color: var(--text); }
				.tn { grid-column: 2; font-size: 12px; color: var(--muted); }
				.down-arrow { padding-left: 136px; color: var(--muted); font-size: 12px; }
				.two { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
				.tier.col { grid-template-columns: 1fr; align-content: start; } .tier.col .tn { grid-column: 1; }
				.zbox { border: 1px dashed var(--muted); border-radius: 8px; padding: 5px 7px; display: flex; gap: 5px; align-items: center; flex-wrap: wrap; }
				.zbox > b { font-size: 11px; color: var(--muted); font-weight: 600; }
				.care { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; font-size: 12px; display: flex; gap: 8px; flex-wrap: wrap; align-items: center; background: var(--soft); }
				.arch2 .tier { border: 1px solid var(--line); border-radius: 12px; padding: 10px 12px; background: var(--win); }
				.arch2 .down-arrow { padding-left: 0; text-align: center; }
				.care .loop { color: var(--muted); }
				.flow-h { font-weight: 600; font-size: 14px; margin: 4px 0 6px; }
				.steps { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(128px, 1fr)); gap: 8px; counter-reset: s; }
				.steps li { counter-increment: s; border: 1px solid var(--line); border-radius: 10px; padding: 10px; display: grid; gap: 4px; align-content: start; }
				.steps li::before { content: counter(s); width: 22px; height: 22px; border-radius: 50%; background: var(--text); color: var(--win); display: grid; place-items: center; font-weight: 700; font-size: 11px; }
				.steps li b { font-size: 13px; }
				.steps li span { color: var(--muted); font-size: 12px; line-height: 1.4; }
				.reqs { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 8px; }
				.reqs div { border: 1px solid var(--line); border-radius: 10px; padding: 8px 10px; font-size: 12px; line-height: 1.4; }
				.reqs b { display: block; font-size: 12px; margin-bottom: 2px; }
				.reqs span { color: var(--muted); }
				.demo { display: grid; grid-template-columns: 1fr 1.1fr; gap: 18px; align-items: start; }
				.demo-l { display: grid; gap: 12px; align-content: start; }
				.say { margin: 0; padding-left: 20px; display: grid; gap: 6px; }
				.lh { border: 1px solid var(--line); border-radius: 12px; padding: 12px; display: grid; gap: 10px; background: var(--win); }
				.lh-top { display: flex; align-items: center; gap: 4px; font-size: 14px; }
				.lh-top .muted { margin-left: 4px; font-size: 12px; }
				.lh-nums { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
				.lh-nums b { display: block; font-size: 24px; font-weight: 600; line-height: 1.1; }
				.lh-nums span { font-size: 11px; color: var(--muted); }
				.spark { width: 100%; height: 44px; display: block; }
				.spark polyline { fill: none; stroke: var(--c-degraded); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
				.spark line { stroke: var(--c-grid); vector-effect: non-scaling-stroke; }
				.spark-l { font-size: 11px; color: var(--muted); margin-top: -6px; }
				.lh-nodes { display: flex; gap: 6px; flex-wrap: wrap; }
				.lh-ev { list-style: none; margin: 0; padding: 8px 0 0; border-top: 1px solid var(--line); display: grid; gap: 3px; }
				.lh-ev li { display: grid; grid-template-columns: 14px 1fr auto; gap: 6px; font-size: 12px !important; line-height: 1.4 !important; }
				.lh-ev time { color: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
				.lh-ev .ic { text-align: center; font-weight: 700; }
				.lh-ev .bad .ic { color: var(--c-lost); } .lh-ev .good .ic { color: var(--ok); } .lh-ev .chaos .ic { color: var(--c-degraded); } .lh-ev .info .ic { color: var(--muted); }
				.members { display: flex; gap: 8px; flex-wrap: wrap; }
				.member.big { padding: 10px 14px; font-size: 14px; }
				.lbars { display: grid; gap: 5px; }
				.lbar { display: grid; grid-template-columns: 58px 1fr 40px; gap: 8px; align-items: center; font-size: 12px; }
				.lbar .track { height: 12px; } .lbar .fill { height: 100%; border-radius: 0 4px 4px 0; background: var(--c-bar); min-width: 2px; }
				.lbar.down .fill { background: var(--c-up); } .lbar small { color: var(--muted); }
				.recap-nums { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10px; }
				.recap-nums div { border: 1px solid var(--line); border-radius: 12px; padding: 12px; }
				.recap-nums b { display: block; font-size: 30px; font-weight: 600; line-height: 1.1; }
				.recap-nums span { font-size: 12px; color: var(--muted); }
				.safety td:first-child { font-weight: 600; }
				.deck-nav { display: flex; align-items: center; gap: 8px; flex: none; }
				.deck-nav .bar { flex: 1; height: 3px; background: var(--soft); border-radius: 2px; overflow: hidden; }
				.deck-nav .bar i { display: block; height: 100%; background: var(--text); }
				table.grid-t { border-collapse: collapse; width: 100%; font-size: 13px; }
				table.grid-t th, table.grid-t td { text-align: left; padding: 7px 8px 7px 0; border-bottom: 1px solid var(--line); }
				table.grid-t th { color: var(--muted); font-weight: 500; font-size: 11px; }
				.cmd { display: flex; gap: 6px; align-items: flex-start; }
				.cmd pre { flex: 1; margin: 0; white-space: pre-wrap; word-break: break-all; }
				@container (max-width: 720px) { .demo, .two { grid-template-columns: 1fr; } .recap-nums { grid-template-columns: 1fr 1fr; } .tier { grid-template-columns: 1fr; } .tn { grid-column: 1; } .down-arrow { padding-left: 0; } }
				.win:fullscreen { border-radius: 0; }
				.win:fullscreen .win-body { padding: 4vh 6vw; }
				.win:fullscreen .slide h1 { font-size: 44px; }
				.win:fullscreen .slide .lead, .win:fullscreen .plain, .win:fullscreen blockquote p { font-size: 20px !important; }
				.win:fullscreen .cover-in .big { font-size: 120px; }
				.win:fullscreen .cover-in .tagline { font-size: 34px; }
				.win:fullscreen .slide p, .win:fullscreen .slide li { font-size: 17px; }
				* { box-sizing: border-box; }
				html, body { height: 100%; margin: 0; }
				body { background: var(--bg) var(--wallpaper) center / cover no-repeat fixed; color: var(--text); font: 13px/1.45 ui-sans-serif, system-ui, -apple-system, sans-serif; overflow: hidden; }
				button, input, select { font: inherit; color: inherit; }
				#bar { position: fixed; inset: 0 0 auto 0; height: 30px; display: flex; align-items: center; gap: 4px; padding: 0 10px; z-index: 100000;
					background: color-mix(in srgb, var(--win) 72%, transparent); backdrop-filter: saturate(180%) blur(20px); -webkit-backdrop-filter: saturate(180%) blur(20px);
					border-bottom: 1px solid color-mix(in srgb, var(--line) 70%, transparent); font-size: 13px; }
				#bar .item { display: inline-flex; align-items: center; gap: 6px; height: 22px; padding: 0 8px; border-radius: 5px; white-space: nowrap; }
				#bar .vlogo { display: block; }
				#bar .app { font-weight: 700; }
				#bar .hint { color: var(--muted); }
				#bar .spacer { flex: 1; }
				#bar .status { font-size: 12px; }
				#bar .status .muted { font-size: 12px; }
				.muted { color: var(--muted); }
				.dot { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: var(--ok); margin-right: 6px; vertical-align: 1px; box-shadow: 0 0 0 2px color-mix(in srgb, var(--ok) 22%, transparent); }
				.dot.warn { background: var(--warn); box-shadow: 0 0 0 2px color-mix(in srgb, var(--warn) 22%, transparent); }
				.dot.bad { background: var(--bad); box-shadow: 0 0 0 2px color-mix(in srgb, var(--bad) 22%, transparent); }
				.dot.idle { background: var(--idle); box-shadow: none; }
				:root {
					--c-degraded: #eda100; --c-lost: #e87ba4; --c-bar: #2a78d6; --c-up: #d9d7d0; --c-grid: #e1e0d9; --c-axis: #898781; --c-surface: var(--win);
				}
				@media (prefers-color-scheme: dark) {
					:root:not([data-theme="light"]) { --c-degraded: #c98500; --c-lost: #d55181; --c-bar: #3987e5; --c-up: #3a3a37; --c-grid: #2c2c2a; }
				}
				:root[data-theme="dark"] { --c-degraded: #c98500; --c-lost: #d55181; --c-bar: #3987e5; --c-up: #3a3a37; --c-grid: #2c2c2a; }
				.st { position: relative; display: grid; gap: 12px; }
				.st-top { display: flex; align-items: center; gap: 10px; }
				.st-status { flex: 1; display: flex; align-items: center; gap: 2px; font-size: 14px; font-weight: 600; }
				.st-status .since { font-weight: 400; color: var(--muted); margin-left: 6px; }
				.seg { display: inline-flex; gap: 1px; padding: 2px; border-radius: 7px; background: color-mix(in srgb, var(--text) 7%, transparent); }
				.seg button { border: 0; background: transparent; padding: 2px 10px; border-radius: 5px; font-size: 12px; cursor: pointer; color: var(--muted); }
				.seg button[aria-pressed="true"] { background: var(--win); color: var(--text); box-shadow: 0 1px 2px rgba(0,0,0,.15); }
				.st-kpis { display: grid; grid-template-columns: 1.3fr repeat(4, 1fr); gap: 8px; }
				.kpi { padding: 10px 12px; border: 1px solid var(--line); border-radius: 10px; min-width: 0; }
				.kpi .label { font-size: 11px; color: var(--muted); }
				.kpi .value { font-size: 22px; font-weight: 600; line-height: 1.2; margin-top: 2px; }
				.kpi .sub { font-size: 11px; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
				.kpi.hero .value { font-size: 40px; letter-spacing: -.02em; }
				.meter { height: 4px; border-radius: 2px; background: color-mix(in srgb, var(--c-bar) 18%, transparent); margin-top: 6px; overflow: hidden; }
				.meter i { display: block; height: 100%; border-radius: 2px; background: var(--c-bar); }
				.st-card { border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px; min-width: 0; }
				.st-card header, .st-card summary { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
				.st-card summary { cursor: pointer; list-style: none; }
				.st-card summary::-webkit-details-marker { display: none; }
				.st-card summary::before { content: "›"; color: var(--muted); transition: transform .15s; display: inline-block; }
				.st-card[open] summary::before { transform: rotate(90deg); }
				.st-card h4 { margin: 0; font-size: 13px; font-weight: 600; flex: 1; }
				.st-card header .legend { display: flex; gap: 12px; font-size: 11px; color: var(--muted); }
				.st-sub { margin: 2px 0 6px; font-size: 11px; color: var(--muted); }
				.legend span { display: inline-flex; align-items: center; gap: 5px; }
				.key { display: inline-block; width: 10px; height: 10px; border-radius: 3px; }
				.k-degraded { background: var(--c-degraded); } .k-lost { background: var(--c-lost); }
				.k-up { background: var(--c-up); } .k-impaired { background: var(--c-degraded); } .k-down { background: var(--c-lost); }
				.chart svg { display: block; width: 100%; overflow: visible; }
				.chart text { font: 10px ui-sans-serif, system-ui, sans-serif; fill: var(--c-axis); }
				.chart .lbl { font-size: 11px; fill: var(--text); font-weight: 600; }
				.st-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
				.bars { display: grid; gap: 4px; margin-top: 6px; }
				.bar-row { display: grid; grid-template-columns: 56px 1fr auto; align-items: center; gap: 8px; border: 0; background: transparent; padding: 3px 4px; border-radius: 6px; cursor: pointer; text-align: left; }
				.bar-row:hover, .bar-row:focus-visible { background: var(--soft); outline: none; }
				.bar-row.sel { background: var(--soft); box-shadow: inset 0 0 0 1px var(--muted); }
				.bar-row .who { font-size: 12px; font-weight: 600; } .bar-row .who small { font-weight: 400; color: var(--muted); margin-left: 4px; }
				.bar-row .track { height: 14px; }
				.bar-row .fill { height: 100%; min-width: 2px; border-radius: 0 4px 4px 0; background: var(--c-bar); transition: width .3s; }
				.bar-row.off .fill { background: var(--c-up); }
				.bar-row .val { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }
				.nodepanel { margin-top: 8px; padding-top: 8px; border-top: 1px solid var(--line); display: grid; gap: 6px; font-size: 12px; }
				.feed { list-style: none; margin: 6px 0 0; padding: 0; display: grid; gap: 2px; max-height: 210px; overflow: auto; }
				.feed li { display: grid; grid-template-columns: 54px 14px 1fr; gap: 6px; align-items: baseline; padding: 3px 4px; border-radius: 5px; font-size: 12px; cursor: default; }
				.feed li:hover { background: var(--soft); }
				.feed time { color: var(--muted); font-size: 11px; font-variant-numeric: tabular-nums; }
				.feed .ic { font-size: 11px; text-align: center; font-weight: 700; }
				.feed .bad .ic { color: var(--c-lost); } .feed .good .ic { color: var(--ok); } .feed .chaos .ic { color: var(--c-degraded); } .feed .info .ic { color: var(--muted); }
				.feed .empty { color: var(--muted); display: block; }
				.raft { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 6px; }
				.member { display: flex; align-items: center; gap: 6px; padding: 5px 10px; border: 1px solid var(--line); border-radius: 8px; font-size: 12px; }
				.member b { font-weight: 600; } .member.leader { border-color: var(--text); }
				.cmap { display: grid; gap: 2px; margin-top: 8px; overflow-x: auto; }
				.cmap .r { display: flex; gap: 2px; align-items: center; }
				.cmap code { width: 76px; flex: none; font-size: 10px; color: var(--muted); }
				.cmap .c { width: 22px; height: 10px; flex: none; border-radius: 2px; background: var(--soft); }
				.cmap .c.ok { background: var(--c-bar); } .cmap .c.stale { background: var(--c-lost); opacity: .6; }
				.cmap .hd span { width: 22px; flex: none; font-size: 10px; text-align: center; color: var(--muted); }
				.st-table table { width: 100%; border-collapse: collapse; font-size: 12px; font-variant-numeric: tabular-nums; }
				.st-table th, .st-table td { text-align: right; padding: 3px 6px; border-bottom: 1px solid var(--line); }
				.st-table th:first-child, .st-table td:first-child { text-align: left; }
				.st-table th { color: var(--muted); font-weight: 500; font-size: 11px; }
				.st-tip { position: absolute; z-index: 10; pointer-events: none; min-width: 140px; padding: 7px 9px; border-radius: 8px; font-size: 12px;
					background: var(--win); border: 1px solid var(--line); box-shadow: var(--shadow); }
				.st-tip .t { color: var(--muted); font-size: 11px; margin-bottom: 3px; }
				.st-tip .row { display: flex; align-items: center; gap: 6px; }
				.st-tip .row b { font-weight: 600; min-width: 22px; }
				.st-tip .row i { display: inline-block; width: 10px; height: 2px; border-radius: 1px; }
				.st-tip .ev { margin-top: 4px; padding-top: 4px; border-top: 1px solid var(--line); }
				.st.stale { opacity: .6; }
				.win-body:has(> .st) { container-type: inline-size; }
				@container (max-width: 640px) { .st-kpis { grid-template-columns: 1fr 1fr; } .kpi.hero { grid-column: 1 / -1; } .st-cols { grid-template-columns: 1fr; } }
				.theme { display: inline-flex; gap: 1px; padding: 2px; border-radius: 7px; background: color-mix(in srgb, var(--text) 7%, transparent); }
				.theme button { border: 0; background: transparent; width: 24px; height: 18px; border-radius: 5px; cursor: pointer; color: var(--muted); display: grid; place-items: center; padding: 0; }
				.theme button svg { width: 12px; height: 12px; }
				.theme button[aria-pressed="true"] { background: var(--win); color: var(--text); box-shadow: 0 1px 2px rgba(0,0,0,.15); }
				#clock { font-variant-numeric: tabular-nums; }
				#desk { position: fixed; inset: 30px 0 84px 0; }
				#dock { position: fixed; left: 50%; bottom: 10px; transform: translateX(-50%); display: flex; align-items: flex-end; gap: 4px; padding: 5px 6px; z-index: 100000;
					background: color-mix(in srgb, var(--win) 60%, transparent); backdrop-filter: saturate(180%) blur(24px); -webkit-backdrop-filter: saturate(180%) blur(24px);
					border: 1px solid color-mix(in srgb, var(--line) 80%, transparent); border-radius: 18px; box-shadow: var(--shadow); }
				#dock button { position: relative; border: 0; background: transparent; padding: 0 3px 7px; cursor: pointer; }
				#dock .ico { width: 46px; height: 46px; border-radius: 11px; display: grid; place-items: center; color: #fff; transition: transform .15s ease; box-shadow: inset 0 0 0 1px rgba(255,255,255,.12), 0 2px 6px rgba(0,0,0,.18); }
				#dock .ico svg { width: 24px; height: 24px; }
				#dock button:hover .ico { transform: translateY(-5px) scale(1.08); }
				#dock .d-files .ico { background: linear-gradient(160deg, #5aa9ff, #1f6fe5); }
				#dock .d-stats .ico { background: linear-gradient(160deg, #4cd98a, #179a55); }
				#dock .d-connect .ico { background: linear-gradient(160deg, #4a4a4f, #1d1d20); }
				#dock .d-present .ico { background: linear-gradient(160deg, #ffb347, #f06a1f); }
				#dock .d-users .ico { background: linear-gradient(160deg, #8b7bff, #5b4bd6); }
				#bar .me { gap: 8px; }
				#bar .me .role { font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); border: 1px solid var(--line); border-radius: 4px; padding: 0 4px; }
				.login { position: fixed; inset: 0; display: grid; place-items: center; padding: 16px; }
				.login form { width: min(360px, 100%); display: grid; gap: 12px; padding: 28px; border-radius: 16px; box-shadow: var(--shadow);
					background: color-mix(in srgb, var(--win) 82%, transparent); backdrop-filter: saturate(180%) blur(24px); -webkit-backdrop-filter: saturate(180%) blur(24px); border: 1px solid var(--line); }
				.login h1 { margin: 4px 0 0; font-size: 22px; }
				.login label { display: grid; gap: 4px; font-size: 12px; color: var(--muted); }
				.login input { font-size: 14px; padding: 8px 10px; border-radius: 8px; border: 1px solid var(--line); background: var(--win); color: var(--text); }
				.login .btn { padding: 8px; font-size: 14px; }
				.secret { display: grid; gap: 6px; padding: 12px; border-radius: 10px; background: var(--soft); border: 1px solid var(--line); }
				.users-t { width: 100%; border-collapse: collapse; font-size: 12px; }
				.users-t td, .users-t th { text-align: left; padding: 6px 6px 6px 0; border-bottom: 1px solid var(--line); }
				.users-t th { color: var(--muted); font-weight: 500; font-size: 11px; }
				#dock .doc .ico { background: linear-gradient(160deg, #c6c6cc, #8e8e96); font-size: 11px; font-weight: 700; }
				#dock .tip { position: absolute; bottom: calc(100% + 10px); left: 50%; transform: translateX(-50%); padding: 3px 9px; border-radius: 6px; font-size: 12px; white-space: nowrap;
					background: var(--win); border: 1px solid var(--line); box-shadow: var(--shadow); opacity: 0; pointer-events: none; transition: opacity .12s; }
				#dock button:hover .tip { opacity: 1; }
				#dock .run { position: absolute; bottom: 1px; left: 50%; width: 4px; height: 4px; margin-left: -2px; border-radius: 50%; background: var(--text); opacity: 0; }
				#dock button.running .run { opacity: .7; }
				#dock .sep { width: 1px; align-self: stretch; margin: 4px 4px 10px; background: var(--line); }
				#dock .sep:last-child { display: none; }
				.win { position: absolute; display: flex; flex-direction: column; min-width: 320px; min-height: 200px; background: var(--win); border-radius: 12px;
					border: 1px solid color-mix(in srgb, var(--line) 90%, transparent); box-shadow: var(--shadow);
					transition: opacity .18s ease, transform .18s ease; transform-origin: 50% 100%; }
				.win:not(.active) { box-shadow: 0 1px 2px rgba(0,0,0,.05), 0 6px 18px rgba(0,0,0,.07); }
				.win.min { opacity: 0; transform: translateY(40vh) scale(.2); pointer-events: none; }
				.win.max { border-radius: 0; }
				.win.moving { transition: none; }
				.win-bar { position: relative; display: flex; align-items: center; height: 38px; padding: 0 12px; flex: none; user-select: none; border-bottom: 1px solid var(--line); border-radius: 12px 12px 0 0; }
				.win.max .win-bar { border-radius: 0; }
				.win-title { position: absolute; left: 90px; right: 90px; text-align: center; font-weight: 600; font-size: 13px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; pointer-events: none; }
				.win:not(.active) .win-title { color: var(--muted); }
				.lights { display: flex; gap: 8px; z-index: 1; }
				.lights button { width: 12px; height: 12px; padding: 0; border-radius: 50%; border: 0; cursor: default; display: grid; place-items: center; box-shadow: inset 0 0 0 .5px rgba(0,0,0,.18); }
				.lights svg { width: 8px; height: 8px; opacity: 0; stroke: rgba(0,0,0,.55); stroke-width: 1.6; fill: none; stroke-linecap: round; }
				.lights:hover svg { opacity: 1; }
				.l-close { background: #ff5f57; } .l-min { background: #febc2e; } .l-max { background: #28c840; }
				.win:not(.active) .lights:not(:hover) button { background: var(--idle); box-shadow: none; }
				.win-body { flex: 1; overflow: auto; padding: 14px; border-radius: 0 0 12px 12px; }
				.win.max .win-body { border-radius: 0; }
				.rz { position: absolute; z-index: 2; }
				.rz.n { top: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; } .rz.s { bottom: -3px; left: 8px; right: 8px; height: 6px; cursor: ns-resize; }
				.rz.e { right: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; } .rz.w { left: -3px; top: 8px; bottom: 8px; width: 6px; cursor: ew-resize; }
				.rz.ne { top: -4px; right: -4px; width: 12px; height: 12px; cursor: nesw-resize; } .rz.sw { bottom: -4px; left: -4px; width: 12px; height: 12px; cursor: nesw-resize; }
				.rz.nw { top: -4px; left: -4px; width: 12px; height: 12px; cursor: nwse-resize; } .rz.se { bottom: -4px; right: -4px; width: 12px; height: 12px; cursor: nwse-resize; }
				.win.max .rz { display: none; }
				#ctx { position: fixed; z-index: 200000; min-width: 210px; padding: 5px; border-radius: 9px; font-size: 13px;
					background: color-mix(in srgb, var(--win) 82%, transparent); backdrop-filter: saturate(180%) blur(24px); -webkit-backdrop-filter: saturate(180%) blur(24px);
					border: 1px solid color-mix(in srgb, var(--line) 90%, transparent); box-shadow: 0 10px 30px rgba(0,0,0,.22), 0 0 0 .5px rgba(0,0,0,.08); }
				#ctx .h { padding: 4px 10px 2px; font-size: 11px; font-weight: 600; color: var(--muted); max-width: 260px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
				#ctx button { display: flex; width: 100%; align-items: center; gap: 8px; padding: 3px 10px 3px 6px; border: 0; border-radius: 5px; background: transparent; text-align: left; cursor: default; white-space: nowrap; }
				#ctx button .chk { width: 14px; text-align: center; font-size: 11px; }
				#ctx button:hover, #ctx button:focus-visible { background: #0a64d8; color: #fff; outline: none; }
				#ctx button.danger { color: var(--bad); }
				#ctx button.danger:hover { color: #fff; background: var(--bad); }
				#ctx hr { border: 0; height: 1px; margin: 4px 6px; background: var(--line); }
				#toast { position: fixed; left: 50%; bottom: 96px; transform: translateX(-50%); z-index: 200000; padding: 6px 14px; border-radius: 8px; font-size: 12px;
					background: var(--text); color: var(--win); box-shadow: var(--shadow); opacity: 0; transition: opacity .2s; pointer-events: none; }
				#toast.show { opacity: 1; }
				.btn { border: 1px solid var(--line); background: var(--win); border-radius: 7px; padding: 4px 10px; cursor: pointer; font-size: 12px; white-space: nowrap; }
				.btn:hover { border-color: var(--muted); }
				.btn.dark { background: var(--text); color: var(--win); border-color: var(--text); }
				.btn.on { background: var(--warn); border-color: var(--warn); color: #fff; }
				.btn.red { color: var(--bad); }
				.btn.xs { padding: 1px 7px; font-size: 11px; }
				input[type=text], select { border: 1px solid var(--line); background: var(--win); border-radius: 7px; padding: 4px 8px; }
				h3 { margin: 18px 0 8px; font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--muted); }
				h3:first-child { margin-top: 0; }
				.err { color: var(--bad); margin: 0 0 10px; }
				.row { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
				.files { min-height: 100%; display: flex; flex-direction: column; gap: 12px; border-radius: 8px; }
				.files.over { outline: 2px dashed var(--muted); outline-offset: -2px; }
				.toolbar { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; }
				.crumb { border: 0; background: transparent; padding: 2px 4px; cursor: pointer; border-radius: 5px; }
				.crumb:hover { background: var(--soft); }
				.crumb:last-of-type { font-weight: 600; }
				.sep { color: var(--muted); }
				.grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(104px, 1fr)); gap: 8px; }
				.tile { border: 1px solid transparent; background: transparent; border-radius: 8px; padding: 8px 6px; cursor: pointer; display: grid; justify-items: center; gap: 6px; text-align: center; min-width: 0; }
				.tile:hover { background: var(--soft); border-color: var(--line); }
				.thumb { width: 64px; height: 64px; border-radius: 8px; object-fit: cover; background: var(--soft); border: 1px solid var(--line); }
				.badge { width: 52px; height: 64px; border-radius: 6px; border: 1px solid var(--line); background: var(--soft); display: grid; place-items: end center; padding-bottom: 8px; font-size: 10px; font-weight: 700; text-transform: uppercase; color: var(--muted); }
				.folder { width: 64px; height: 48px; margin-top: 10px; border-radius: 6px; background: var(--idle); position: relative; }
				.folder::before { content: ""; position: absolute; left: 0; top: -6px; width: 26px; height: 10px; border-radius: 4px 4px 0 0; background: var(--idle); }
				.folder.bucket { background: var(--text); } .folder.bucket::before { background: var(--text); }
				.tile .name { font-size: 12px; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
				.tile .sub { font-size: 11px; color: var(--muted); margin-top: -4px; }
				.empty { flex: 1; display: grid; place-items: center; color: var(--muted); border: 1px dashed var(--line); border-radius: 8px; padding: 32px; text-align: center; }
				.upload-form progress { display: none; width: 90px; height: 6px; }
				.upload-form.htmx-request progress { display: inline-block; }
				.upload-form.htmx-request label { display: none; }
				.stats { display: grid; grid-template-columns: repeat(auto-fill, minmax(96px, 1fr)); gap: 14px 10px; }
				.stat b { display: block; font-size: 18px; font-weight: 600; font-variant-numeric: tabular-nums; }
				.stat span { font-size: 11px; color: var(--muted); }
				.health { display: flex; align-items: center; gap: 4px; font-size: 15px; font-weight: 600; margin-bottom: 14px; }
				.nodes { display: grid; gap: 6px; }
				.node { display: grid; grid-template-columns: 1fr auto; gap: 4px 10px; padding: 8px 10px; border: 1px solid var(--line); border-radius: 8px; }
				.node.dead { background: color-mix(in srgb, var(--bad) 7%, transparent); }
				.node .id { font-weight: 600; }
				.chips { grid-column: 1 / -1; display: flex; gap: 4px; flex-wrap: wrap; align-items: center; font-size: 11px; }
				.heat { display: grid; gap: 2px; overflow-x: auto; }
				.hrow { display: flex; gap: 2px; align-items: center; }
				.hrow code, .hhead i { width: 76px; flex: none; font: 10px ui-monospace, monospace; color: var(--muted); }
				.hrow.degraded code { color: var(--warn); } .hrow.lost code { color: var(--bad); }
				.hhead { display: flex; gap: 2px; }
				.hhead span { width: 22px; flex: none; font-size: 10px; text-align: center; color: var(--muted); }
				.cell { width: 22px; height: 10px; flex: none; border-radius: 2px; background: var(--soft); }
				.cell.ok { background: var(--ok); } .cell.stale { background: var(--bad); opacity: .55; }
				.viewer { display: grid; gap: 14px; }
				.preview { display: grid; place-items: center; background: var(--soft); border-radius: 8px; min-height: 160px; overflow: hidden; }
				.preview img, .preview video { max-width: 100%; max-height: 320px; display: block; }
				.preview iframe { width: 100%; height: 280px; border: 0; background: #fff; }
				.preview audio { width: 90%; }
				table.kv { border-collapse: collapse; width: 100%; }
				table.kv td { padding: 3px 0; vertical-align: top; }
				table.kv td:first-child { color: var(--muted); width: 90px; }
				code, .mono { font: 11px ui-monospace, monospace; word-break: break-all; }
				.chunk { display: flex; align-items: center; gap: 8px; padding: 4px 0; border-bottom: 1px solid var(--line); }
				.pill { font-size: 10px; padding: 0 6px; border-radius: 99px; background: var(--ok); color: #fff; }
				.pill.down { background: var(--idle); color: var(--muted); text-decoration: line-through; }
				pre { background: var(--soft); border-radius: 8px; padding: 10px; overflow-x: auto; font: 11px/1.6 ui-monospace, monospace; margin: 6px 0 0; }
				@media (max-width: 700px) {
					.win { left: 6px !important; right: 6px; width: auto !important; top: 6px !important; height: calc(100% - 12px) !important; }
					.rz, #bar .hint { display: none; }
				}
			</style>
}

// Desktop is the whole OS shell; apps load into windows via htmx.
// Admins get the cluster apps; other users get their own files and keys.
templ Desktop(me Session) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@pageHead("Vault OS")
		</head>
		<body data-admin?={ me.Admin }>
			<div id="bar">
				<span class="item">@Logo(16, "bar")<span class="app" id="app-name">Vault OS</span></span>
				<span class="item hint">S3-compatible, self-healing object storage</span>
				<span class="spacer"></span>
				if me.Admin {
					<span class="item status" hx-get="/app/pulse" hx-trigger="load, every 2s"><span class="dot idle"></span></span>
				}
				<span class="item">
					<span class="theme" role="group" aria-label="Theme">
						<button data-theme-set="system" title="Match system" aria-label="Match system"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="1.5" y="2.5" width="13" height="9" rx="1.5"></rect><path d="M5.5 14h5M8 11.5V14"></path></svg></button>
						<button data-theme-set="light" title="Light" aria-label="Light"><svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"><circle cx="8" cy="8" r="3"></circle><path d="M8 1v1.5M8 13.5V15M1 8h1.5M13.5 8H15M3 3l1 1M12 12l1 1M3 13l1-1M12 4l1-1"></path></svg></button>
						<button data-theme-set="dark" title="Dark" aria-label="Dark"><svg viewBox="0 0 16 16" fill="currentColor"><path d="M13.5 10.2A6 6 0 0 1 5.8 2.5a6 6 0 1 0 7.7 7.7Z"></path></svg></button>
					</span>
				</span>
				<span class="item" id="clock"></span>
				<form class="item me" method="post" action="/logout">
					<span title={ me.AccessKey }>{ me.Name }</span>
					if me.Admin {
						<span class="role">admin</span>
					}
					<button class="btn xs" type="submit">Log out</button>
				</form>
			</div>
			<div id="desk"></div>
			<nav id="dock">
				<button class="d-files" data-open="files" data-title="Files" data-url="/app/files" aria-label="Files">
					<span class="ico"><svg viewBox="0 0 24 24" fill="#fff"><path d="M3 6.5A1.5 1.5 0 0 1 4.5 5h4.6l2 2h8.4A1.5 1.5 0 0 1 21 8.5V17.5A1.5 1.5 0 0 1 19.5 19h-15A1.5 1.5 0 0 1 3 17.5Z" opacity=".95"></path></svg></span><span class="tip">Files</span><span class="run"></span>
				</button>
				if me.Admin {
					<button class="d-stats" data-open="stats" data-title="Stats" data-url="/app/stats" aria-label="Stats">
						<span class="ico"><svg viewBox="0 0 24 24" fill="#fff"><rect x="4" y="12" width="3.5" height="7" rx="1"></rect><rect x="10.25" y="7" width="3.5" height="12" rx="1"></rect><rect x="16.5" y="4" width="3.5" height="15" rx="1"></rect></svg></span><span class="tip">Stats</span><span class="run"></span>
					</button>
				}
				<button class="d-connect" data-open="connect" data-title="Connect" data-url="/app/connect" aria-label="Connect">
					<span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 8 4 4-4 4M12.5 16H18"></path></svg></span><span class="tip">Connect</span><span class="run"></span>
				</button>
				if me.Admin {
					<button class="d-present" data-open="present" data-title="Present" data-url="/app/present?n=0" aria-label="Present">
						<span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M10 8.2v5.6l4.6-2.8Z" fill="#fff" stroke="none"></path><path d="M8 21h8M12 17v4"></path></svg></span><span class="tip">Present</span><span class="run"></span>
					</button>
				}
				if me.Admin {
					<button class="d-users" data-open="users" data-title="Users" data-url="/app/users" aria-label="Users">
						<span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3.2"></circle><path d="M3.5 19c.6-3.2 2.9-5 5.5-5s4.9 1.8 5.5 5"></path><path d="M15.5 5.2a3 3 0 0 1 0 5.6M17.5 14.3c1.6.7 2.7 2.3 3 4.7"></path></svg></span><span class="tip">Users</span><span class="run"></span>
					</button>
				}
				<span class="sep"></span>
			</nav>
			<div id="ctx" role="menu" hidden></div>
			<div id="toast" role="status" aria-live="polite"></div>
			<template id="win-tpl">
				<div class="win">
					<div class="win-bar">
						<div class="lights">
							<button class="l-close" data-win="close" title="Close" aria-label="Close"><svg viewBox="0 0 8 8"><path d="M1.5 1.5l5 5M6.5 1.5l-5 5"></path></svg></button>
							<button class="l-min" data-win="min" title="Minimize" aria-label="Minimize"><svg viewBox="0 0 8 8"><path d="M1.2 4h5.6"></path></svg></button>
							<button class="l-max" data-win="max" title="Zoom" aria-label="Zoom"><svg viewBox="0 0 8 8"><path d="M2 2h3.2L2 5.2Z M6 6H2.8L6 2.8Z" fill="rgba(0,0,0,.55)" stroke="none"></path></svg></button>
						</div>
						<span class="win-title"></span>
					</div>
					<div class="win-body"></div>
					<span class="rz n" data-rz="n"></span><span class="rz s" data-rz="s"></span><span class="rz e" data-rz="e"></span><span class="rz w" data-rz="w"></span>
					<span class="rz ne" data-rz="ne"></span><span class="rz nw" data-rz="nw"></span><span class="rz se" data-rz="se"></span><span class="rz sw" data-rz="sw"></span>
				</div>
			</template>
			<script>
			(() => {
				const desk = document.getElementById('desk');
				const sizes = { files: [640, 480], stats: [760, 720], connect: [520, 420], present: [980, 660], users: [620, 480] };
				let z = 10, cascade = 0;

				const dock = document.getElementById('dock');
				const appName = document.getElementById('app-name');
				const wins = () => [...desk.querySelectorAll('.win')];

				const focus = win => {
					wins().forEach(w => w.classList.remove('active'));
					win.style.zIndex = ++z;
					win.classList.add('active');
					appName.textContent = win.dataset.key.startsWith('view:') ? 'Files' : win.dataset.title;
				};
				// After a window closes or minimizes, hand focus to the topmost visible one.
				const refocus = () => {
					const top = wins().filter(w => !w.classList.contains('min')).sort((a, b) => b.style.zIndex - a.style.zIndex)[0];
					if (top) focus(top); else appName.textContent = 'Vault OS';
				};
				// Dock state: a dot under running apps; minimized documents get their own dock tile.
				const syncDock = () => {
					dock.querySelectorAll('button[data-open]').forEach(b => b.classList.toggle('running', wins().some(w => w.dataset.key === b.dataset.open)));
					dock.querySelectorAll('.doc').forEach(d => d.remove());
					for (const w of wins()) {
						if (!w.classList.contains('min') || dock.querySelector(`button[data-open="${CSS.escape(w.dataset.key)}"]:not(.doc)`)) continue;
						const b = document.createElement('button');
						b.className = 'doc';
						b.dataset.restore = w.dataset.key;
						b.innerHTML = '<span class="ico"></span><span class="tip"></span>';
						b.querySelector('.ico').textContent = (w.dataset.title.split('.').pop() || 'doc').slice(0, 4).toUpperCase();
						b.querySelector('.tip').textContent = w.dataset.title;
						dock.appendChild(b);
					}
					dock.querySelector('.sep').style.display = dock.querySelector('.doc') ? 'block' : 'none';
				};

				const restore = win => { win.classList.remove('min'); focus(win); syncDock(); };
				const minimize = win => { win.classList.add('min'); win.classList.remove('active'); refocus(); syncDock(); };
				const toggleMax = win => {
					if (win.classList.toggle('max')) {
						win.dataset.geom = JSON.stringify([win.style.left, win.style.top, win.style.width, win.style.height]);
						Object.assign(win.style, { left: '0px', top: '0px', width: desk.clientWidth + 'px', height: desk.clientHeight + 'px' });
					} else if (win.dataset.geom) {
						const [left, top, width, height] = JSON.parse(win.dataset.geom);
						Object.assign(win.style, { left, top, width, height });
					}
				};
				window.closeWin = el => { el.closest('.win')?.remove(); refocus(); syncDock(); };

				window.openApp = (key, title, url, pos) => {
					let win = wins().find(w => w.dataset.key === key);
					if (win) return restore(win);
					win = document.getElementById('win-tpl').content.firstElementChild.cloneNode(true);
					win.dataset.key = key;
					win.dataset.title = title;
					win.querySelector('.win-title').textContent = title;
					const [w, h] = sizes[key] || [520, 460];
					const off = (cascade++ % 6) * 26;
					Object.assign(win.style, {
						width: Math.min(w, desk.clientWidth - 16) + 'px',
						height: Math.min(h, desk.clientHeight - 16) + 'px',
						left: (pos ? pos[0] : 120 + off) + 'px',
						top: (pos ? pos[1] : 24 + off) + 'px',
					});
					desk.appendChild(win);
					focus(win);
					syncDock();
					const body = win.querySelector('.win-body');
					// Each window is its own request source; sharing <body> makes htmx drop concurrent loads.
					htmx.ajax('GET', url, { source: body, target: body, swap: 'innerHTML' });
				};

				document.addEventListener('click', e => {
					const r = e.target.closest('[data-restore]');
					if (r) { const w = wins().find(w => w.dataset.key === r.dataset.restore); if (w) restore(w); return; }
					const o = e.target.closest('[data-open]');
					if (o) openApp(o.dataset.open, o.dataset.title, o.dataset.url);
					const ctl = e.target.closest('[data-win]');
					if (!ctl) return;
					const win = ctl.closest('.win');
					if (ctl.dataset.win === 'close') closeWin(win);
					if (ctl.dataset.win === 'min') minimize(win);
					if (ctl.dataset.win === 'max') toggleMax(win);
				});
				desk.addEventListener('dblclick', e => {
					if (e.target.closest('.win-bar') && !e.target.closest('button')) toggleMax(e.target.closest('.win'));
				});

				// Pointer drags: move by the title bar, resize from any edge or corner.
				const drag = (e, win, onMove) => {
					e.preventDefault();
					win.classList.add('moving');
					const start = { x: e.clientX, y: e.clientY, l: win.offsetLeft, t: win.offsetTop, w: win.offsetWidth, h: win.offsetHeight };
					const move = m => onMove(m.clientX - start.x, m.clientY - start.y, start);
					const up = () => { win.classList.remove('moving'); removeEventListener('pointermove', move); removeEventListener('pointerup', up); };
					addEventListener('pointermove', move);
					addEventListener('pointerup', up);
				};
				desk.addEventListener('pointerdown', e => {
					const win = e.target.closest('.win');
					if (!win) return;
					focus(win);
					const rz = e.target.closest('[data-rz]');
					if (rz) {
						const d = rz.dataset.rz;
						return drag(e, win, (dx, dy, s) => {
							const minW = 320, minH = 200;
							if (d.includes('e')) win.style.width = Math.max(minW, Math.min(s.w + dx, desk.clientWidth - s.l)) + 'px';
							if (d.includes('s')) win.style.height = Math.max(minH, Math.min(s.h + dy, desk.clientHeight - s.t)) + 'px';
							if (d.includes('w')) { const w = Math.max(minW, s.w - dx); win.style.width = w + 'px'; win.style.left = (s.l + s.w - w) + 'px'; }
							if (d.includes('n')) { const h = Math.max(minH, Math.min(s.h - dy, s.t + s.h)); win.style.height = h + 'px'; win.style.top = (s.t + s.h - h) + 'px'; }
						});
					}
					if (!e.target.closest('.win-bar') || e.target.closest('button')) return;
					drag(e, win, (dx, dy, s) => {
						if (win.classList.contains('max')) return;
						win.style.left = Math.max(-s.w + 100, Math.min(s.l + dx, desk.clientWidth - 100)) + 'px';
						win.style.top = Math.max(0, Math.min(s.t + dy, desk.clientHeight - 38)) + 'px';
					});
				});
				addEventListener('resize', () => wins().filter(w => w.classList.contains('max')).forEach(w => Object.assign(w.style, { width: desk.clientWidth + 'px', height: desk.clientHeight + 'px' })));

				// Upload: pick with the button, or drop files anywhere on a Files window.
				const submitFiles = (files, zone) => {
					const form = zone.querySelector('.upload-form');
					if (!form || !files.length) return;
					const input = form.querySelector('input[type=file]');
					if (input.files !== files) input.files = files;
					htmx.trigger(form, 'submit');
				};
				document.addEventListener('change', e => {
					if (e.target.matches('.upload-form input[type=file]')) submitFiles(e.target.files, e.target.closest('.files'));
				});
				document.addEventListener('dragover', e => {
					const zone = e.target.closest('.files');
					e.preventDefault();
					document.querySelectorAll('.files.over').forEach(f => f !== zone && f.classList.remove('over'));
					zone?.classList.add('over');
				});
				document.addEventListener('dragleave', e => { if (!e.relatedTarget) document.querySelectorAll('.files.over').forEach(f => f.classList.remove('over')); });
				document.addEventListener('drop', e => {
					e.preventDefault();
					const zone = e.target.closest('.files');
					document.querySelectorAll('.files.over').forEach(f => f.classList.remove('over'));
					if (zone) submitFiles(e.dataTransfer.files, zone);
				});
				document.body.addEventListener('htmx:xhr:progress', e => {
					const p = e.target.querySelector?.('progress');
					if (p && e.detail.lengthComputable) p.value = e.detail.loaded / e.detail.total;
				});

				// Theme: System follows the OS; Light/Dark are remembered in this browser.
				const applyTheme = t => {
					if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
					else delete document.documentElement.dataset.theme;
					document.querySelectorAll('[data-theme-set]').forEach(b => b.setAttribute('aria-pressed', String(b.dataset.themeSet === (t || 'system'))));
				};
				let saved = 'system';
				try { saved = localStorage.getItem('vault-theme') || 'system'; } catch {}
				applyTheme(saved);
				document.addEventListener('click', e => {
					const b = e.target.closest('[data-theme-set]');
					if (!b) return;
					applyTheme(b.dataset.themeSet);
					try { localStorage.setItem('vault-theme', b.dataset.themeSet); } catch {}
				});

				// Present: arrow keys / space step through slides; F toggles fullscreen.
				document.addEventListener('keydown', e => {
					const win = desk.querySelector('.win.active[data-key="present"]');
					if (!win || e.target.closest?.('input, select, textarea')) return;
					const go = sel => { const b = win.querySelector(sel); if (b) { e.preventDefault(); b.click(); } };
					if (e.key === 'ArrowRight' || e.key === ' ' || e.key === 'PageDown') go('[data-nav="next"]');
					if (e.key === 'ArrowLeft' || e.key === 'PageUp') go('[data-nav="prev"]');
					if (e.key === 'f') toggleFull(win);
				});
				window.toggleFull = el => {
					const win = el.closest('.win');
					if (document.fullscreenElement) document.exitFullscreen(); else win.requestFullscreen?.();
				};
				document.addEventListener('click', e => {
					const c = e.target.closest('[data-copy]');
					if (!c) return;
					navigator.clipboard?.writeText(c.dataset.copy);
					c.textContent = 'Copied';
					setTimeout(() => c.textContent = 'Copy', 1200);
				});

				const clock = document.getElementById('clock');
				const tick = () => { const d = new Date(); clock.textContent = d.toLocaleDateString([], { weekday: 'short', day: 'numeric', month: 'short' }) + '  ' + d.toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' }); };
				tick(); setInterval(tick, 10000);

				// ---- Right-click menus ----
				const ctx = document.getElementById('ctx');
				const toast = msg => { const t = document.getElementById('toast'); t.textContent = msg; t.classList.add('show'); clearTimeout(t._h); t._h = setTimeout(() => t.classList.remove('show'), 1800); };
				const copy = (text, what) => navigator.clipboard?.writeText(text).then(() => toast(what + ' copied'), () => toast('Copy failed'));
				const post = async (url, done) => {
					const r = await fetch(url, { method: 'POST' });
					const body = await r.text();
					if (!r.ok || body.includes('class="err"')) { toast((body.match(/class="err">([^<]*)/)?.[1] || body || r.statusText).slice(0, 120)); return false; }
					if (done) toast(done);
					return true;
				};
				const changed = () => htmx.trigger(document.body, 'vault:changed');
				const q = encodeURIComponent;
				const s3uri = (b, k = '') => `s3://${b}/${k}`;
				const apps = () => [...dock.querySelectorAll('button[data-open]')].map(b => [b.dataset.open, b.dataset.title, b.dataset.url]);

				const menuFor = e => {
					const t = e.target;
					const el = t.closest('[data-ctx]');
					const win = t.closest('.win');
					if (el?.dataset.ctx === 'file') {
						const { bucket, key, dl } = el.dataset;
						return [{ head: key },
							{ label: 'Open', act: () => el.click() },
							{ label: 'Download', act: () => { const a = document.createElement('a'); a.href = dl; a.download = key.split('/').pop(); a.click(); } },
							{ sep: 1 },
							{ label: 'Copy S3 URI', act: () => copy(s3uri(bucket, key), 'S3 URI') },
							{ label: 'Copy link', act: () => copy(location.origin + dl, 'Link') },
							{ label: 'Show where it\u2019s stored', act: () => {
								el.click();
								const w = wins().find(w => w.dataset.key === el.dataset.open);
								w?.querySelector('.win-body').addEventListener('htmx:afterSettle', () => w.querySelector('.viewer h3')?.scrollIntoView({ behavior: 'smooth' }), { once: true });
							} },
							{ sep: 1 },
							{ label: 'Delete', danger: 1, act: async () => {
								if (!confirm(`Delete \u201c${key}\u201d?`)) return;
								if (await post(`/app/files/delete?bucket=${q(bucket)}&key=${q(key)}`, 'Deleted ' + key.split('/').pop())) {
									wins().find(w => w.dataset.key === el.dataset.open)?.remove();
									changed(); syncDock();
								}
							} }];
					}
					if (el?.dataset.ctx === 'folder') {
						return [{ head: el.dataset.prefix },
							{ label: 'Open', act: () => el.click() },
							{ label: 'Copy S3 URI', act: () => copy(s3uri(el.dataset.bucket, el.dataset.prefix), 'S3 URI') }];
					}
					if (el?.dataset.ctx === 'bucket') {
						const b = el.dataset.bucket;
						return [{ head: 'Bucket ' + b },
							{ label: 'Open', act: () => el.click() },
							{ label: 'Copy S3 URI', act: () => copy(s3uri(b), 'S3 URI') },
							{ sep: 1 },
							{ label: 'Delete bucket', danger: 1, act: async () => {
								if (!confirm(`Delete bucket \u201c${b}\u201d? It must be empty.`)) return;
								if (await post(`/app/files/dropbucket?bucket=${q(b)}`, 'Deleted bucket ' + b)) changed();
							} }];
					}
					if (el?.dataset.ctx === 'node') {
						const { node: id, alive, slow, cutMeta } = el.dataset;
						const act = (a, msg) => () => post(`/ui/nodes/${id}/${a}`, msg);
						return [{ head: 'Storage node ' + id },
							alive === 'true' ? { label: 'Kill', danger: 1, act: act('kill', id + ' killed') } : { label: 'Revive', act: act('revive', id + ' revived') },
							{ label: 'Damage a piece', act: act('corrupt', 'Flipped a byte on ' + id) },
							{ label: slow === 'true' ? 'Make fast again' : 'Make slow', act: act('slow', slow === 'true' ? id + ' is fast' : id + ' is slow') },
							{ label: cutMeta === 'true' ? 'Restore link to metadata' : 'Cut link to metadata', act: act('partition?peer=meta', 'Link toggled') }];
					}
					if (el?.dataset.ctx === 'files') {
						const form = el.querySelector('.upload-form');
						const input = el.querySelector('input[name=name]');
						return [{ head: el.dataset.bucket ? s3uri(el.dataset.bucket, el.dataset.prefix) : 'Buckets' },
							form && { label: 'Upload files\u2026', act: () => form.querySelector('input[type=file]').click() },
							input && { label: 'New bucket\u2026', act: () => input.focus() },
							el.dataset.bucket && { label: 'Copy S3 URI', act: () => copy(s3uri(el.dataset.bucket, el.dataset.prefix), 'S3 URI') },
							{ label: 'Refresh', act: () => htmx.ajax('GET', el.getAttribute('hx-get'), { source: el, target: el, swap: 'outerHTML' }) }];
					}
					if (win && t.closest('.win-bar')) {
						return [{ head: win.dataset.title },
							{ label: 'Minimize', act: () => minimize(win) },
							{ label: win.classList.contains('max') ? 'Restore size' : 'Zoom', act: () => toggleMax(win) },
							{ sep: 1 },
							{ label: 'Close', act: () => closeWin(win) },
							{ label: 'Close other windows', act: () => { wins().filter(w => w !== win).forEach(w => w.remove()); syncDock(); } }];
					}
					const dockBtn = t.closest('#dock button');
					if (dockBtn) {
						const key = dockBtn.dataset.open || dockBtn.dataset.restore;
						const w = wins().find(w => w.dataset.key === key);
						const title = dockBtn.dataset.title || w?.dataset.title;
						if (!w) return [{ head: title }, { label: 'Open', act: () => dockBtn.click() }];
						return [{ head: title },
							{ label: 'Show', act: () => restore(w) },
							!w.classList.contains('min') && { label: 'Minimize', act: () => minimize(w) },
							{ sep: 1 },
							{ label: 'Quit', act: () => closeWin(w) }];
					}
					if (!win) {
						const theme = document.documentElement.dataset.theme || 'system';
						const setTheme = v => () => { applyTheme(v); try { localStorage.setItem('vault-theme', v); } catch {} };
						return [{ head: 'Vault OS' },
							...apps().map(([k, title, url]) => ({ label: 'Open ' + title, act: () => openApp(k, title, url) })),
							{ sep: 1 },
							{ head: 'Appearance' },
							{ label: 'System', check: theme === 'system', act: setTheme('system') },
							{ label: 'Light', check: theme === 'light', act: setTheme('light') },
							{ label: 'Dark', check: theme === 'dark', act: setTheme('dark') },
							{ sep: 1 },
							{ label: 'Show all windows', act: () => wins().forEach(w => w.classList.remove('min')) || syncDock() },
							{ label: 'Minimize all', act: () => wins().forEach(minimize) },
							{ label: 'Close all windows', act: () => { wins().forEach(w => w.remove()); refocus(); syncDock(); } }];
					}
					return null; // inside window content: keep the browser's own menu
				};

				const hideMenu = () => { ctx.hidden = true; ctx.replaceChildren(); };
				document.addEventListener('contextmenu', e => {
					if (e.target.closest?.('input, textarea, select, #ctx')) return;
					const items = menuFor(e)?.filter(Boolean);
					if (!items) return hideMenu();
					e.preventDefault();
					ctx.replaceChildren(...items.map(it => {
						if (it.sep) return document.createElement('hr');
						if (it.head) { const h = document.createElement('div'); h.className = 'h'; h.textContent = it.head; return h; }
						const b = document.createElement('button');
						b.setAttribute('role', 'menuitem');
						if (it.danger) b.className = 'danger';
						b.innerHTML = '<span class="chk"></span><span></span>';
						b.firstChild.textContent = it.check ? '\u2713' : '';
						b.lastChild.textContent = it.label;
						b.onclick = () => { hideMenu(); it.act(); };
						return b;
					}));
					ctx.hidden = false;
					const { innerWidth: vw, innerHeight: vh } = window;
					ctx.style.left = Math.min(e.clientX, vw - ctx.offsetWidth - 6) + 'px';
					ctx.style.top = Math.min(e.clientY, vh - ctx.offsetHeight - 6) + 'px';
					ctx.querySelector('button')?.focus({ preventScroll: true });
				});
				addEventListener('pointerdown', e => { if (!ctx.hidden && !e.target.closest?.('#ctx')) hideMenu(); }, true);
				addEventListener('keydown', e => {
					if (ctx.hidden) return;
					e.stopPropagation(); // keys drive the menu, not the window behind it
					const items = [...ctx.querySelectorAll('button')];
					const i = items.indexOf(document.activeElement);
					if (e.key === 'Escape') hideMenu();
					if (e.key === 'ArrowDown') { e.preventDefault(); items[(i + 1) % items.length]?.focus(); }
					if (e.key === 'ArrowUp') { e.preventDefault(); items[(i - 1 + items.length) % items.length]?.focus(); }
				}, true);
				addEventListener('blur', hideMenu);
				addEventListener('resize', hideMenu);

				// ---- Stats app: charts drawn from /app/stats/data, refreshed every second ----
				const NS = 'http://www.w3.org/2000/svg';
				const svgEl = (tag, attrs, parent) => { const e = document.createElementNS(NS, tag); for (const k in attrs || {}) e.setAttribute(k, attrs[k]); parent?.appendChild(e); return e; };
				const el = (tag, cls, text, parent) => { const e = document.createElement(tag); if (cls) e.className = cls; if (text != null) e.textContent = text; parent?.appendChild(e); return e; };
				const bytes = n => { const u = ['B', 'KiB', 'MiB', 'GiB', 'TiB']; let i = 0; while (n >= 1024 && i < u.length - 1) { n /= 1024; i++; } return (i ? n.toFixed(1) : n) + ' ' + u[i]; };
				const hms = t => new Date(t).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit', hourCycle: 'h23' });
				const dur = ms => ms < 1000 ? ms + 'ms' : ms < 60000 ? (ms / 1000).toFixed(1).replace(/\.0$/, '') + 's' : Math.floor(ms / 60000) + 'm ' + Math.round(ms % 60000 / 1000) + 's';
				const niceMax = v => [4, 5, 10, 20, 25, 50, 100, 200, 250, 500, 1000].find(n => v <= n) ?? Math.ceil(v / 1000) * 1000;
				const byId = (a, b) => a.localeCompare(b, undefined, { numeric: true });
				const icons = { bad: '✕', good: '✓', chaos: '⚡', info: '•' };
				const stateName = { up: 'Online', impaired: 'Impaired', down: 'Offline' };

				window.mountStats = root => {
					root.dataset.mounted = '1';
					const $ = n => root.querySelector(`[data-el="${n}"]`);
					const css = v => getComputedStyle(root).getPropertyValue(v).trim();
					const tip = $('tip');
					let range = 300, data = null, sel = null, table = false, timer;
					let hover = null; // { t, row?, ev } — shared crosshair across the time charts
					const charts = {};
					const sigs = {};
					const changed = (key, v) => { const s = JSON.stringify(v); if (sigs[key] === s) return false; sigs[key] = s; return true; };

					// ---- tooltip ----
					const placeTip = ev => {
						const r = root.getBoundingClientRect();
						let x = ev.clientX - r.left + 14;
						if (x + tip.offsetWidth > r.width) x = ev.clientX - r.left - tip.offsetWidth - 14;
						tip.style.left = Math.max(0, x) + 'px';
						tip.style.top = (ev.clientY - r.top + 14) + 'px';
					};
					const showTip = (ev, build) => { tip.replaceChildren(); build(tip); tip.hidden = false; placeTip(ev); };
					const hideTip = () => { tip.hidden = true; };
					const tipRow = (parent, color, value, label) => {
						const r = el('div', 'row', null, parent);
						el('i', null, null, r).style.background = color;
						el('b', null, String(value), r);
						el('span', 'muted', label, r);
					};

					// ---- shared time frame ----
					const frame = (w, m) => {
						const t1 = data.now, t0 = t1 - range * 1000, span = w - m.l - m.r;
						return { t0, t1, x: t => m.l + (t - t0) / (t1 - t0) * span, tAt: px => t0 + (px - m.l) / span * (t1 - t0) };
					};
					const timeAxis = (svg, f, h) => {
						const step = range <= 60 ? 15 : range <= 300 ? 60 : 180;
						for (let s = range; s >= 0; s -= step) {
							const txt = svgEl('text', { x: f.x(f.t1 - s * 1000), y: h - 3, 'text-anchor': s === range ? 'start' : s === 0 ? 'end' : 'middle' }, svg);
							txt.textContent = s === 0 ? 'now' : (s >= 60 ? s / 60 + 'm' : s + 's') + ' ago';
						}
					};
					const segments = () => {
						const out = []; let cur = [];
						for (const p of data.samples) {
							if (cur.length && p.t - cur[cur.length - 1].t > 3000) { out.push(cur); cur = []; }
							cur.push(p);
						}
						if (cur.length) out.push(cur);
						return out;
					};
					const nearest = t => data.samples.reduce((best, p) => !best || Math.abs(p.t - t) < Math.abs(best.t - t) ? p : best, null);
					const overlay = (svg, key, w, h, m, rowAt) => {
						const r = svgEl('rect', { x: m.l, y: 0, width: Math.max(0, w - m.l - m.r), height: h, fill: 'transparent' }, svg);
						r.style.cursor = 'crosshair';
						r.addEventListener('pointermove', ev => {
							const b = svg.getBoundingClientRect(), scale = w / b.width;
							const px = (ev.clientX - b.left) * scale, py = (ev.clientY - b.top) * scale;
							hover = { t: charts[key].f.tAt(px), row: rowAt?.(py), ev, src: key };
							updateCross();
						});
						r.addEventListener('pointerleave', () => { hover = null; updateCross(); });
					};

					// ---- chart 1: chunks missing a copy (stacked: missing, lost) ----
					const drawMissing = () => {
						const box = $('missing'), w = Math.max(280, box.clientWidth), h = 150, m = { l: 28, r: 34, t: 10, b: 18 };
						const f = frame(w, m), pts = data.samples;
						const top = niceMax(Math.max(0, ...pts.map(p => p.d + p.l)));
						const y = v => h - m.b - v / top * (h - m.t - m.b);
						const svg = svgEl('svg', { viewBox: `0 0 ${w} ${h}`, height: h, role: 'img', 'aria-label': 'Pieces missing a copy over time' });
						for (const v of [0, top / 2, top]) {
							svgEl('line', { x1: m.l, x2: w - m.r, y1: y(v), y2: y(v), stroke: v === 0 ? css('--c-axis') : css('--c-grid'), 'stroke-opacity': v === 0 ? 0.5 : 1 }, svg);
							svgEl('text', { x: m.l - 6, y: y(v) + 3, 'text-anchor': 'end' }, svg).textContent = v;
						}
						timeAxis(svg, f, h);
						for (const e of data.events) {
							if (e.k === 'info' || f.x(e.t) < m.l) continue;
							const x = f.x(e.t);
							svgEl('line', { x1: x, x2: x, y1: m.t, y2: h - m.b, stroke: css('--c-grid') }, svg);
							svgEl('circle', { cx: x, cy: m.t, r: 4, fill: e.k === 'good' ? css('--ok') : e.k === 'bad' ? css('--c-lost') : css('--c-degraded'), stroke: css('--c-surface'), 'stroke-width': 2 }, svg);
						}
						const layers = [
							{ top: p => p.d, base: () => 0, color: css('--c-degraded') },
							{ top: p => p.d + p.l, base: p => p.d, color: css('--c-lost') },
						];
						for (const L of layers) {
							for (const seg of segments()) {
								const has = i => seg[i] && L.top(seg[i]) > L.base(seg[i]);
								if (!seg.some((_, i) => has(i))) continue;
								const upper = seg.map(p => `${f.x(p.t)},${y(L.top(p))}`);
								const lower = seg.slice().reverse().map(p => `${f.x(p.t)},${y(L.base(p))}`);
								svgEl('polygon', { points: upper.concat(lower).join(' '), fill: L.color, 'fill-opacity': 0.14 }, svg);
								let d = '', pen = false;
								seg.forEach((p, i) => {
									if (has(i) || has(i - 1) || has(i + 1)) { d += `${pen ? 'L' : 'M'}${f.x(p.t)},${y(L.top(p))}`; pen = true; } else pen = false;
								});
								svgEl('path', { d, fill: 'none', stroke: L.color, 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }, svg);
							}
						}
						const last = pts[pts.length - 1];
						if (last) {
							svgEl('text', { x: w - m.r + 6, y: y(last.d) + 4, class: 'lbl' }, svg).textContent = last.d;
							if (last.l > 0) svgEl('text', { x: w - m.r + 6, y: y(last.d + last.l) - 6, class: 'lbl' }, svg).textContent = last.l;
						} else {
							svgEl('text', { x: w / 2, y: h / 2, 'text-anchor': 'middle' }, svg).textContent = 'Collecting samples…';
						}
						overlay(svg, 'missing', w, h, m);
						charts.missing = { svg, f, h, m, y };
						box.replaceChildren(svg);
					};

					const drawTable = () => {
						const box = $('table');
						const rows = [];
						let prev = null;
						for (const p of data.samples) {
							const off = Object.values(p.n).filter(s => s !== 'up').length;
							const key = `${p.d}/${p.l}/${off}`;
							if (key !== prev) rows.push([hms(p.t), p.d, p.l, off]);
							prev = key;
						}
						const t = el('table');
						const hd = el('tr', null, null, t);
						for (const c of ['Time', 'Missing a copy', 'Lost', 'Nodes not online']) el('th', null, c, hd);
						for (const r of rows.reverse().slice(0, 60)) { const tr = el('tr', null, null, t); r.forEach(c => el('td', null, String(c), tr)); }
						box.replaceChildren(t);
						el('p', 'st-sub', 'One row per change in the selected range, newest first.', box);
					};

					// ---- chart 2: node lanes ----
					const laneColor = s => s === 'down' ? css('--c-lost') : s === 'impaired' ? css('--c-degraded') : css('--c-up');
					const drawLanes = () => {
						const box = $('lanes'), ids = data.nodes.map(n => n.id).sort(byId);
						const w = Math.max(280, box.clientWidth), rowH = 14, gap = 6, m = { l: 28, r: 34, t: 2, b: 18 };
						const h = m.t + Math.max(1, ids.length) * (rowH + gap) - gap + m.b;
						const f = frame(w, m);
						const svg = svgEl('svg', { viewBox: `0 0 ${w} ${h}`, height: h, role: 'img', 'aria-label': 'Storage node status over time' });
						ids.forEach((id, i) => {
							const y0 = m.t + i * (rowH + gap);
							svgEl('text', { x: m.l - 6, y: y0 + rowH - 3, 'text-anchor': 'end' }, svg).textContent = id;
							for (const seg of segments()) {
								let start = 0;
								for (let j = 1; j <= seg.length; j++) {
									const st = seg[start].n[id];
									if (j < seg.length && seg[j].n[id] === st) continue;
									const x1 = f.x(seg[start].t), x2 = Math.min(w - m.r, f.x(j < seg.length ? seg[j].t : seg[seg.length - 1].t + 1000));
									if (st) svgEl('rect', { x: x1, y: y0, width: Math.max(1, x2 - x1 - (j < seg.length ? 2 : 0)), height: rowH, rx: 3, fill: laneColor(st) }, svg);
									start = j;
								}
							}
							const cur = data.nodes.find(n => n.id === id);
							svgEl('text', { x: w - m.r + 6, y: y0 + rowH - 3 }, svg).textContent = cur.state === 'up' ? 'on' : cur.state === 'down' ? 'off' : '!';
						});
						timeAxis(svg, f, h);
						overlay(svg, 'lanes', w, h, m, py => ids[Math.floor((py - m.t) / (rowH + gap))]);
						charts.lanes = { svg, f, h, m };
						box.replaceChildren(svg);
					};

					// ---- shared crosshair + time tooltip ----
					const updateCross = () => {
						for (const c of Object.values(charts)) c.svg.querySelector('.xh')?.remove();
						if (!hover || !data?.samples.length) { if (!hover) hideTip(); return; }
						const p = nearest(hover.t);
						for (const [key, c] of Object.entries(charts)) {
							if (!c.svg.isConnected) continue;
							const g = svgEl('g', { class: 'xh', 'pointer-events': 'none' }, c.svg);
							const x = c.f.x(p.t);
							svgEl('line', { x1: x, x2: x, y1: c.m.t, y2: c.h - c.m.b, stroke: css('--text'), 'stroke-opacity': 0.35 }, g);
							if (key === 'missing') {
								svgEl('circle', { cx: x, cy: c.y(p.d), r: 4, fill: css('--c-degraded'), stroke: css('--c-surface'), 'stroke-width': 2 }, g);
								if (p.l > 0) svgEl('circle', { cx: x, cy: c.y(p.d + p.l), r: 4, fill: css('--c-lost'), stroke: css('--c-surface'), 'stroke-width': 2 }, g);
							}
						}
						if (!hover.ev) return hideTip();
						showTip(hover.ev, t => {
							el('div', 't', hms(p.t), t);
							if (hover.row) {
								const r = el('div', 'row', null, t);
								el('i', null, null, r).style.background = laneColor(p.n[hover.row]);
								el('b', null, hover.row, r);
								el('span', 'muted', stateName[p.n[hover.row]] || 'not in cluster', r);
							}
							tipRow(t, css('--c-degraded'), p.d, 'missing a copy');
							tipRow(t, css('--c-lost'), p.l, 'lost');
							const off = Object.entries(p.n).filter(([, s]) => s !== 'up').map(([id]) => id).sort(byId);
							el('div', 'muted', off.length ? 'Not online: ' + off.join(', ') : 'All nodes online', t);
							for (const e of data.events.filter(e => Math.abs(e.t - p.t) <= 1500)) {
								el('div', 'ev', `${icons[e.k] || '•'} ${e.text}`, t);
							}
						});
					};

					// ---- headline ----
					const drawStatus = () => {
						const box = $('status');
						const off = data.nodes.filter(n => n.state !== 'up');
						let cls = 'ok', icon = '✓', text = 'Fully redundant', since = '';
						if (data.err) { cls = 'bad'; icon = '✕'; text = 'Metadata unreachable'; since = 'retrying…'; }
						else if (data.lost > 0) { cls = 'bad'; icon = '✕'; text = `${data.lost} piece${data.lost > 1 ? 's' : ''} lost`; since = 'no live copy left'; }
						else if (data.under > 0 || data.healingMs > 0) { cls = 'warn'; icon = '↻'; text = `Repairing ${data.under} piece${data.under === 1 ? '' : 's'}`; since = data.healingMs ? 'for ' + dur(data.healingMs) : ''; }
						else if (off.length) since = `${off.map(n => n.id).join(', ')} not online · data already re-replicated`;
						if (!changed('status', [cls, text, since])) return;
						box.replaceChildren();
						el('span', 'dot ' + cls, null, box);
						el('span', null, `${icon} ${text}`, box);
						if (since) el('span', 'since', since, box);
					};
					const drawKpis = () => {
						const total = data.totalChunks, healthy = total - data.under - data.lost;
						const pct = total ? Math.floor(healthy / total * 1000) / 10 : 100;
						const up = data.nodes.filter(n => n.state === 'up').length;
						const tiles = [
							['hero', 'Pieces fully copied', pct + '%', `${healthy} of ${total} pieces have every copy`, pct],
							['', 'Nodes online', `${up}/${data.nodes.length}`, data.nodes.length - up ? `${data.nodes.length - up} impaired or offline` : 'all healthy'],
							['', 'Last recovery', data.mttrMs ? dur(data.mttrMs) : '–', `${data.repairs} repairs · ${data.rebalances} moves`],
							['', 'Stored', bytes(data.logical), `${data.objects} objects`],
							['', 'Storage overhead', data.logical ? (data.raw / data.logical).toFixed(2) + '×' : '–', `${bytes(data.raw)} on disk`],
						];
						if (!changed('kpis', tiles)) return;
						const box = $('kpis');
						box.replaceChildren();
						for (const [cls, label, value, sub, meter] of tiles) {
							const k = el('div', 'kpi ' + cls, null, box);
							el('div', 'label', label, k);
							el('div', 'value', value, k);
							el('div', 'sub', sub, k);
							if (meter != null) el('i', null, null, el('div', 'meter', null, k)).style.width = meter + '%';
						}
					};

					// ---- chunks per node (click → actions) ----
					const drawBars = () => {
						const box = $('bars'), nodes = data.nodes.slice().sort((a, b) => byId(a.id, b.id));
						const maxC = Math.max(1, ...nodes.map(n => n.chunks));
						for (const r of [...box.children]) if (!nodes.some(n => n.id === r.dataset.node)) r.remove();
						nodes.forEach((n, i) => {
							let b = box.querySelector(`[data-node="${CSS.escape(n.id)}"]`);
							if (!b) {
								b = el('button', 'bar-row');
								b.dataset.ctx = 'node';
								b.dataset.node = n.id;
								el('span', 'who', null, b);
								el('span', 'fill', null, el('span', 'track', null, b)).style.display = 'block';
								el('span', 'val', null, b);
								b.addEventListener('click', () => { sel = sel === n.id ? null : n.id; sigs.panel = null; drawBars(); drawPanel(); });
								b.addEventListener('pointermove', ev => {
									const cur = data.nodes.find(x => x.id === n.id);
									if (!cur) return;
									showTip(ev, t => {
										el('div', 't', `${cur.id} · zone ${cur.zone}`, t);
										tipRow(t, css('--c-bar'), cur.chunks, 'pieces');
										el('div', null, `${bytes(cur.used)} on disk`, t);
										el('div', 'muted', stateName[cur.state], t);
									});
								});
								b.addEventListener('pointerleave', hideTip);
							}
							if (box.children[i] !== b) box.insertBefore(b, box.children[i] || null);
							b.className = 'bar-row' + (n.state === 'down' ? ' off' : '') + (sel === n.id ? ' sel' : '');
							b.dataset.alive = String(n.state !== 'down');
							b.dataset.slow = String(n.slow);
							b.dataset.cutMeta = String(n.partitioned.includes('meta'));
							b.setAttribute('aria-label', `${n.id}, zone ${n.zone}, ${n.chunks} pieces, ${stateName[n.state]}`);
							const who = b.querySelector('.who');
							who.textContent = n.id;
							el('small', null, n.zone, who);
							b.querySelector('.fill').style.width = (n.chunks / maxC * 100) + '%';
							b.querySelector('.val').textContent = `${n.chunks} · ${bytes(n.used)}${n.state === 'up' ? '' : ' · ' + stateName[n.state].toLowerCase()}`;
						});
					};
					const act = async (url, msg) => { if (await post(url, msg)) refresh(); };
					const drawPanel = () => {
						const p = $('nodepanel'), n = data.nodes.find(n => n.id === sel);
						if (!n) { p.hidden = true; sigs.panel = null; return; }
						if (!changed('panel', [n.id, n.state, n.slow, n.partitioned, data.nodes.map(x => x.id)])) return;
						p.hidden = false;
						p.replaceChildren();
						el('div', null, `${n.id} · zone ${n.zone} · ${n.addr} · ${stateName[n.state]}`, p);
						const row = el('div', 'row', null, p);
						const btn = (label, cls, url, msg) => { const b = el('button', 'btn xs ' + cls, label, row); b.onclick = () => act(url, msg); };
						if (n.state === 'down') btn('Revive', '', `/ui/nodes/${n.id}/revive`, `${n.id} revived`);
						else btn('Kill', 'red', `/ui/nodes/${n.id}/kill`, `${n.id} killed`);
						btn('Damage a piece', '', `/ui/nodes/${n.id}/corrupt`, `Flipped a byte on ${n.id}`);
						btn(n.slow ? 'Make fast' : 'Make slow', n.slow ? 'on' : '', `/ui/nodes/${n.id}/slow`, n.slow ? `${n.id} is fast` : `${n.id} is slow`);
						const chips = el('div', 'row', null, p);
						el('span', 'muted', 'Cut link to', chips);
						for (const peer of data.nodes.map(x => x.id).filter(x => x !== n.id).sort(byId).concat('meta', 'gateway')) {
							const on = n.partitioned.includes(peer);
							const b = el('button', 'btn xs' + (on ? ' on' : ''), peer, chips);
							b.setAttribute('aria-pressed', String(on));
							b.onclick = () => act(`/ui/nodes/${n.id}/partition?peer=${encodeURIComponent(peer)}`, on ? `Restored ${n.id} ↔ ${peer}` : `Cut ${n.id} ↔ ${peer}`);
						}
					};

					// ---- activity feed ----
					const drawFeed = () => {
						const evs = data.events.slice().reverse().slice(0, 40);
						if (!changed('feed', evs)) return;
						const box = $('feed');
						box.replaceChildren();
						if (!evs.length) { el('li', 'empty', 'Nothing yet. Kill a node or upload a file and watch this fill in.', box); return; }
						for (const e of evs) {
							const li = el('li', e.k, null, box);
							el('time', null, hms(e.t), li);
							el('span', 'ic', icons[e.k] || '•', li);
							el('span', null, e.text, li);
							li.addEventListener('pointerenter', () => { hover = { t: e.t }; updateCross(); });
							li.addEventListener('pointerleave', () => { hover = null; updateCross(); });
						}
					};

					// ---- raft + chunk map ----
					const drawRaft = () => {
						if (!changed('raft', data.raft)) return;
						const box = $('raft');
						box.replaceChildren();
						for (const r of data.raft.slice().sort((a, b) => byId(a.id, b.id))) {
							const m = el('div', 'member' + (r.state === 'Leader' ? ' leader' : ''), null, box);
							el('span', 'dot ' + (!r.up ? 'bad' : r.state === 'Leader' ? 'ok' : 'idle'), null, m);
							el('b', null, (r.state === 'Leader' ? '★ ' : '') + r.id, m);
							el('span', 'muted', r.up ? `${r.state} · term ${r.term}` : 'unreachable', m);
						}
					};
					const drawMap = () => {
						const ids = data.nodes.map(n => n.id).sort(byId);
						const alive = Object.fromEntries(data.nodes.map(n => [n.id, n.state !== 'down']));
						if (!changed('map', [data.chunks, alive])) return;
						const box = $('map');
						box.replaceChildren();
						const hd = el('div', 'r hd', null, box);
						el('code', null, '', hd);
						ids.forEach(id => el('span', null, id, hd));
						for (const c of data.chunks) {
							const r = el('div', 'r', null, box);
							el('code', null, c.sha.slice(0, 10), r);
							for (const id of ids) {
								const has = c.holders.includes(id), state = has ? (alive[id] ? 'ok' : 'stale') : '';
								const cell = el('span', 'c ' + state, null, r);
								cell.addEventListener('pointermove', ev => showTip(ev, t => {
									el('div', 't', c.sha.slice(0, 16) + '…', t);
									el('div', null, `${id}: ${state === 'ok' ? 'holds a copy' : state === 'stale' ? 'copy on an offline node' : 'no copy'}`, t);
									el('div', 'muted', `wants ${c.want} copies`, t);
								}));
								cell.addEventListener('pointerleave', hideTip);
							}
						}
					};

					// ---- controls + polling ----
					const render = () => {
						drawStatus(); drawKpis();
						if (table) drawTable(); else drawMissing();
						drawLanes(); drawBars(); drawPanel(); drawFeed(); drawRaft();
						$('mapsub').textContent = `${data.totalChunks} pieces${data.moreChunks > 0 ? ` (first ${data.chunks.length} shown)` : ''}`;
						if ($('mapbox').open) drawMap();
						updateCross();
					};
					const refresh = async () => {
						if (!root.isConnected) return clearInterval(timer);
						if (document.hidden) return;
						try {
							const r = await fetch(`/app/stats/data?range=${range}`, { cache: 'no-store' });
							data = await r.json();
						} catch {
							root.classList.add('stale'); // keep the last frame, dimmed, until the next poll works
							return;
						}
						root.classList.remove('stale');
						render();
					};
					root.querySelectorAll('[data-range]').forEach(b => b.addEventListener('click', () => {
						range = +b.dataset.range;
						root.querySelectorAll('[data-range]').forEach(x => x.setAttribute('aria-pressed', String(x === b)));
						refresh();
					}));
					$('tabletoggle').addEventListener('click', e => {
						table = !table;
						e.currentTarget.setAttribute('aria-pressed', String(table));
						e.currentTarget.classList.toggle('on', table);
						$('missing').hidden = table; $('table').hidden = !table;
						if (table) charts.missing?.svg.remove(), delete charts.missing;
						if (data) render();
					});
					$('stepdown').addEventListener('click', () => act('/ui/meta/stepdown', 'Election forced'));
					$('mapbox').addEventListener('toggle', () => { sigs.map = null; if (data && $('mapbox').open) drawMap(); });
					let lastW = 0;
					new ResizeObserver(([e]) => { const w = Math.round(e.contentRect.width); if (data && w !== lastW) { lastW = w; render(); } }).observe(root);
					timer = setInterval(refresh, 1000);
					refresh();
				};
				document.body.addEventListener('htmx:afterSettle', e => e.target.querySelectorAll?.('[data-stats]:not([data-mounted])').forEach(mountStats));
				document.body.addEventListener('htmx:responseError', e => { if (e.detail.xhr.status === 401) location.href = '/login'; });

				// Start with the two apps that tell the story side by side.
				const half = desk.clientWidth / 2;
				openApp('files', 'Files', '/app/files', desk.clientWidth > 1100 ? [Math.max(16, half - 640), 24] : null);
				if (document.body.hasAttribute('data-admin')) openApp('stats', 'Stats', '/app/stats', desk.clientWidth > 1100 ? [half - 20, 12] : null);
			})();
			</script>
		</body>
	</html>
}

templ Pulse(c Cluster) {
	{{ label, class := c.Health() }}
	<span class={ "dot", class }></span>{ label } <span class="muted">· { c.AliveNodes() }</span>
}

// ---- Files ----

templ FilesApp(f Files) {
	<div class="files" data-ctx="files" data-bucket={ f.Bucket } data-prefix={ f.Prefix } hx-get={ f.URL() } hx-trigger="vault:changed from:body" hx-swap="outerHTML">
		<div class="toolbar">
			for i, c := range f.Crumbs() {
				if i > 0 {
					<span class="sep">/</span>
				}
				<button class="crumb" hx-get={ c.URL } hx-target="closest .files" hx-swap="outerHTML">{ c.Name }</button>
			}
			<span style="flex:1"></span>
			if f.Bucket != "" {
				<span class="muted">{ f.Policy }</span>
				<form class="upload-form" hx-post={ "/app/files/upload?bucket=" + urlq(f.Bucket) + "&prefix=" + urlq(f.Prefix) } hx-encoding="multipart/form-data" hx-target="closest .files" hx-swap="outerHTML">
					<label class="btn dark">Upload<input type="file" name="files" multiple hidden/></label>
					<progress max="1" value="0"></progress>
				</form>
			}
		</div>
		if f.Err != "" {
			<p class="err">{ f.Err }</p>
		}
		if f.Bucket == "" {
			<div class="grid">
				for _, b := range f.Buckets {
					<button class="tile" data-ctx="bucket" data-bucket={ b.Name } hx-get={ FilesURL(b.Name, "") } hx-target="closest .files" hx-swap="outerHTML">
						<div class="folder bucket"></div>
						<div class="name">{ b.Name }</div>
						<div class="sub">{ b.Policy }</div>
					</button>
				}
			</div>
			<form class="row" hx-post="/app/files/bucket" hx-target="closest .files" hx-swap="outerHTML" style="margin-top:auto">
				<input type="text" name="name" placeholder="new-bucket" required pattern="[a-z0-9][a-z0-9.\-]{1,61}[a-z0-9]"/>
				<select name="policy">
					<option value="3/2">3 copies · 2 acks</option>
					<option value="2/1">2 copies · 1 ack</option>
					<option value="1/1">1 copy · no redundancy</option>
					<option value="5/3">5 copies · 3 acks</option>
				</select>
				<button class="btn" type="submit">Create bucket</button>
			</form>
		} else if len(f.Folders) == 0 && len(f.Objects) == 0 {
			<div class="empty">
				<div>
					Drop any files here, or use Upload.
					<br/>
					if f.Prefix == "" {
						<button class="btn red" style="margin-top:12px" hx-post={ "/app/files/dropbucket?bucket=" + urlq(f.Bucket) } hx-target="closest .files" hx-swap="outerHTML">Delete empty bucket</button>
					}
				</div>
			</div>
		} else {
			<div class="grid">
				for _, p := range f.Folders {
					<button class="tile" data-ctx="folder" data-bucket={ f.Bucket } data-prefix={ p } hx-get={ FilesURL(f.Bucket, p) } hx-target="closest .files" hx-swap="outerHTML">
						<div class="folder"></div>
						<div class="name">{ FolderName(p) }</div>
					</button>
				}
				for _, o := range f.Objects {
					<button class="tile" data-ctx="file" data-bucket={ o.Bucket } data-key={ o.Key } data-dl={ o.URL() } data-open={ "view:" + o.Bucket + "/" + o.Key } data-title={ o.Name } data-url={ o.ViewURL() } title={ o.Key }>
						if o.Kind() == "image" {
							<img class="thumb" src={ o.URL() } alt="" loading="lazy"/>
						} else {
							<div class="badge">{ o.Ext() }</div>
						}
						<div class="name">{ o.Name }</div>
						<div class="sub">{ o.Size }</div>
					</button>
				}
			</div>
		}
	</div>
}

// ---- Viewer ----

templ ViewerApp(v Viewer) {
	<div class="viewer">
		<div class="preview">
			switch v.Kind() {
				case "image":
					<img src={ v.URL() } alt={ v.Name }/>
				case "video":
					<video src={ v.URL() } controls></video>
				case "audio":
					<audio src={ v.URL() } controls></audio>
				case "doc":
					<iframe src={ v.URL() } title={ v.Name }></iframe>
				default:
					<p class="muted">No preview for { v.Type }</p>
			}
		</div>
		<table class="kv">
			<tr><td>Name</td><td>{ v.Key }</td></tr>
			<tr><td>Bucket</td><td>{ v.Bucket }</td></tr>
			<tr><td>Type</td><td>{ v.Type }</td></tr>
			<tr><td>Size</td><td>{ v.Size }</td></tr>
			<tr><td>Modified</td><td>{ v.Modified }</td></tr>
			<tr><td>ETag</td><td class="mono">{ v.ETag }</td></tr>
		</table>
		<div class="row">
			<a class="btn" href={ templ.URL(v.URL()) } download={ v.Name }>Download</a>
			<button class="btn red" hx-post={ "/app/files/delete?bucket=" + urlq(v.Bucket) + "&key=" + urlq(v.Key) } hx-confirm="Delete this object?" hx-swap="none" hx-on--after-request="if (event.detail.successful) closeWin(this)">Delete</button>
		</div>
		<div>
			<h3>Where the bytes live · { fmt.Sprint(len(v.Chunks)) } pieces</h3>
			for _, c := range v.Chunks {
				<div class="chunk">
					<span class="muted">#{ fmt.Sprint(c.N) }</span>
					<code title={ c.SHA }>{ c.SHA[:12] }</code>
					<span class="muted">{ c.Size }</span>
					<span style="flex:1"></span>
					for _, h := range c.Holders {
						<span class={ "pill", templ.KV("down", !h.Alive) }>{ h.ID }</span>
					}
				</div>
			}
		</div>
	</div>
}

// ---- Stats ----

templ StatsApp() {
	<div class="st" data-stats>
		<div class="st-top">
			<div class="st-status" data-el="status"><span class="dot idle"></span>Connecting…</div>
			<div class="seg" role="group" aria-label="Time range">
				<button data-range="60">1m</button>
				<button data-range="300" aria-pressed="true">5m</button>
				<button data-range="900">15m</button>
			</div>
		</div>
		<div class="st-kpis" data-el="kpis"></div>
		<section class="st-card">
			<header>
				<h4>Pieces missing a copy</h4>
				<div class="legend">
					<span><i class="key k-degraded"></i>Missing a copy · repairing</span>
					<span><i class="key k-lost"></i>Lost · no live copy</span>
				</div>
				<button class="btn xs" data-el="tabletoggle" aria-pressed="false">Table</button>
			</header>
			<p class="st-sub">Flat at zero means every piece has all its copies. A failure shows as a spike; its width is the time to repair.</p>
			<div class="chart" data-el="missing"></div>
			<div class="st-table" data-el="table" hidden></div>
		</section>
		<section class="st-card">
			<header>
				<h4>Storage nodes</h4>
				<div class="legend">
					<span><i class="key k-up"></i>Online</span>
					<span><i class="key k-impaired"></i>Impaired</span>
					<span><i class="key k-down"></i>Offline</span>
				</div>
			</header>
			<div class="chart" data-el="lanes"></div>
		</section>
		<div class="st-cols">
			<section class="st-card">
				<header><h4>Pieces per server</h4><span class="st-sub">Click a node for actions</span></header>
				<div class="bars" data-el="bars"></div>
				<div class="nodepanel" data-el="nodepanel" hidden></div>
			</section>
			<section class="st-card">
				<header><h4>Activity</h4></header>
				<ol class="feed" data-el="feed"></ol>
			</section>
		</div>
		<section class="st-card">
			<header>
				<h4>Metadata · Raft</h4>
				<button class="btn xs" data-el="stepdown">Force election</button>
			</header>
			<div class="raft" data-el="raft"></div>
		</section>
		<details class="st-card" data-el="mapbox">
			<summary><h4>Piece map</h4><span class="st-sub" data-el="mapsub"></span></summary>
			<div class="cmap" data-el="map"></div>
		</details>
		<div class="st-tip" data-el="tip" role="tooltip" hidden></div>
	</div>
}

// ---- Connect ----

templ ConnectApp(endpoint, accessKey string, https bool) {
	<p>Vault speaks the S3 API. Point any S3 tool at it with <b>your</b> keys:</p>
	if https {
		<pre>{ "export AWS_ENDPOINT_URL=" + endpoint + "\nexport AWS_CA_BUNDLE=data/certs/ca.pem   # Vault's private CA\nexport AWS_ACCESS_KEY_ID=" + accessKey + "\nexport AWS_SECRET_ACCESS_KEY=<your secret key>\nexport AWS_DEFAULT_REGION=us-east-1" }</pre>
	} else {
		<pre>{ "export AWS_ENDPOINT_URL=" + endpoint + "\nexport AWS_ACCESS_KEY_ID=" + accessKey + "\nexport AWS_SECRET_ACCESS_KEY=<your secret key>\nexport AWS_DEFAULT_REGION=us-east-1" }</pre>
	}
	<pre>{ "aws s3 mb s3://my-photos\naws s3 sync ./pics s3://my-photos/\naws s3 ls\naws s3 cp s3://my-photos/cat.jpg ." }</pre>
	<p class="muted">You only see and touch your own buckets. Your secret key was shown once, when your account was created; ask an admin for a new user if you lost it.</p>
}

// Login is the sign-in page: the same access keys as the S3 API.
templ Login(msg string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@pageHead("Sign in · Vault")
		</head>
		<body>
			<main class="login">
				<form method="post" action="/login">
					@Logo(44, "login")
					<h1>Sign in to Vault</h1>
					<p class="muted" style="margin:0">Use your Vault access key and secret key.</p>
					if msg != "" {
						<p class="err" role="alert">{ msg }</p>
					}
					<label>Access key<input name="access_key" autocomplete="username" required autofocus/></label>
					<label>Secret key<input name="secret_key" type="password" autocomplete="current-password" required/></label>
					<button class="btn dark" type="submit">Sign in</button>
				</form>
			</main>
		</body>
	</html>
}

// UsersApp lists tenants; a new user's secret is shown exactly once.
templ UsersApp(users []UserRow, created *NewUser, msg string) {
	<div class="users" style="display:grid;gap:12px">
		if msg != "" {
			<p class="err">{ msg }</p>
		}
		if created != nil {
			<div class="secret">
				<b>{ created.Name } can now sign in and use the S3 API.</b>
				<span class="muted">Copy the secret now: it will not be shown again.</span>
				<pre>{ "Access key: " + created.AccessKey + "\nSecret key: " + created.SecretKey }</pre>
				<div class="row"><button class="btn xs" data-copy={ created.SecretKey }>Copy secret</button></div>
			</div>
		}
		<form class="row" hx-post="/app/users" hx-target="closest .win-body" hx-swap="innerHTML">
			<input type="text" name="name" placeholder="name, e.g. alice" required maxlength="64"/>
			<label class="row" style="gap:4px"><input type="checkbox" name="admin"/> admin</label>
			<button class="btn dark" type="submit">Create user</button>
		</form>
		<table class="users-t">
			<tr><th>Name</th><th>Access key</th><th>Role</th><th>Created</th><th></th></tr>
			for _, u := range users {
				<tr>
					<td>{ u.Name }</td>
					<td><code>{ u.AccessKey }</code></td>
					<td>
						if u.Admin {
							admin
						} else {
							user
						}
					</td>
					<td class="muted">{ u.Created }</td>
					<td>
						if u.You {
							<span class="muted">you</span>
						} else {
							<button class="btn xs red" hx-post={ "/app/users/delete?key=" + urlq(u.AccessKey) } hx-confirm={ "Delete " + u.Name + "? Their keys stop working within seconds." } hx-target="closest .win-body" hx-swap="innerHTML">Delete</button>
						}
					</td>
				</tr>
			}
		</table>
		<p class="muted">Users see and manage only the buckets they create. Admins see everything and can use Stats, Present and fault injection.</p>
	</div>
}

// ---- Logo ----

// Logo is Vault's mark: a "V" under three dots, one piece kept as three copies.
templ Logo(size int, id string) {
	<svg class="vlogo" width={ fmt.Sprint(size) } height={ fmt.Sprint(size) } viewBox="0 0 32 32" aria-hidden="true">
		<defs>
			<linearGradient id={ "vg-" + id } x1="0" y1="0" x2="1" y2="1">
				<stop offset="0" stop-color="#5b6cff"></stop>
				<stop offset="1" stop-color="#a44cf5"></stop>
			</linearGradient>
		</defs>
		<rect width="32" height="32" rx="8" fill={ "url(#vg-" + id + ")" }></rect>
		<circle cx="10" cy="8.6" r="2" fill="#fff"></circle>
		<circle cx="16" cy="8.6" r="2" fill="#fff"></circle>
		<circle cx="22" cy="8.6" r="2" fill="#fff"></circle>
		<path d="M9.2 13.6 16 25l6.8-11.4" fill="none" stroke="#fff" stroke-width="3.2" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
}

// ---- Present ----

templ PresentApp(d Deck) {
	<div class="deck">
		<div class={ "slide", "s-" + d.Kind }>
			if d.Kind != "cover" {
				<div class="kicker">{ d.Kicker }</div>
				<h1>{ d.Title }</h1>
				if d.Lead != "" && d.Kind != "problem" {
					<p class="lead">{ d.Lead }</p>
				}
			}
			switch d.Kind {
				case "cover":
					@coverSlide()
				case "problem":
					<blockquote>
						for _, p := range ProblemStatement {
							<p>{ p }</p>
						}
					</blockquote>
					<p class="plain">{ d.Lead }</p>
				case "idea":
					@ideaSlide()
					@actions(d.Acts)
				case "arch":
					<div hx-get="/app/present/live?w=arch" hx-trigger="load, every 2s" hx-swap="innerHTML"></div>
				case "flows":
					@flowsSlide()
				case "reqs":
					<div class="reqs">
						for _, r := range Requirements {
							<div><b>{ r.Need }</b><span>{ r.How }</span></div>
						}
					</div>
				case "demo":
					<div class="demo">
						<div class="demo-l">
							<ol class="say">
								for _, line := range d.Say {
									<li>{ line }</li>
								}
							</ol>
							if d.Cmd != "" {
								<p style="margin:0">Run this in a terminal:</p>
								<div class="cmd"><pre>{ d.Cmd }</pre><button class="btn xs" data-copy={ d.Cmd }>Copy</button></div>
							}
							if len(d.Acts) > 0 {
								@actions(d.Acts)
							}
						</div>
						<div hx-get={ d.LiveURL() } hx-trigger="load, every 1s" hx-swap="innerHTML"></div>
					</div>
				case "safety":
					@safetySlide()
				case "recap":
					<div hx-get="/app/present/live?w=recap" hx-trigger="load, every 1s" hx-swap="innerHTML"></div>
					<ul class="say">
						<li>Survived a server crash, silent disk corruption, a network split and losing the head librarian.</li>
						<li>Repaired itself every time, with no human involved, and timed its own recovery.</li>
						<li>Speaks standard S3, so existing tools and apps work with it unchanged.</li>
						<li>Next: erasure coding (the same safety at 1.5× space) and a catalog split across several librarian groups.</li>
					</ul>
					@actions(d.Acts)
			}
		</div>
		<div class="deck-nav">
			<button class="btn" data-nav="prev" hx-get={ d.URL(d.N - 1) } hx-target="closest .deck" hx-swap="outerHTML" disabled?={ !d.HasPrev() }>← Prev</button>
			<div class="bar"><i style={ fmt.Sprintf("width:%d%%", (d.N+1)*100/d.Total) }></i></div>
			<span class="muted">{ d.Progress() }</span>
			<button class="btn" onclick="toggleFull(this)" title="Fullscreen (F)">⤢</button>
			<button class="btn dark" data-nav="next" hx-get={ d.URL(d.N + 1) } hx-target="closest .deck" hx-swap="outerHTML" disabled?={ !d.HasNext() }>Next →</button>
		</div>
	</div>
}

// actions are a slide's buttons; each one's reply lands in the line below.
templ actions(acts []Action) {
	<div class="acts">
		for _, a := range acts {
			<button class={ "btn", templ.KV("red", a.Danger), templ.KV("dark", !a.Danger) } hx-post={ a.Post } hx-target="next .out" hx-swap="innerHTML">{ a.Label }</button>
		}
	</div>
	<div class="out" aria-live="polite"></div>
}

templ coverSlide() {
	<div class="cover-in">
		@Logo(84, "cover")
		<h1 class="big">Vault</h1>
		<p class="tagline">Storage that heals itself.</p>
		<p class="blurb">Drop a file in. Pull the plug on a server. Your file is still there, and Vault quietly repairs the damage on its own.</p>
		<div class="tags">
			<span class="tag">Works with S3 tools</span>
			<span class="tag">Built in Go</span>
			<span class="tag">Self-healing</span>
			<span class="tag">Live demo in the slides</span>
		</div>
		<p class="hint">← → to move · F for fullscreen</p>
	</div>
}

templ ideaSlide() {
	<div class="idea">
		<div class="i-card">
			<div class="doc">FILE</div>
			<b>Your file</b>
			<small>a photo, a video, a backup: any size</small>
		</div>
		<span class="arrow">→</span>
		<div class="i-card">
			<div class="row"><span class="pc p1">1</span><span class="pc p2">2</span><span class="pc p3">3</span></div>
			<b>Cut into pieces</b>
			<small>4 MB each, and every piece gets a fingerprint</small>
		</div>
		<span class="arrow">→</span>
		<div class="i-card">
			<div class="row">
				<div class="zone"><b>Zone A</b><div class="row"><span class="pc p1">1</span><span class="pc p2">2</span><span class="pc p3">3</span></div></div>
				<div class="zone"><b>Zone B</b><div class="row"><span class="pc p1">1</span><span class="pc p2">2</span><span class="pc p3">3</span></div></div>
				<div class="zone"><b>Zone C</b><div class="row"><span class="pc p1">1</span><span class="pc p2">2</span><span class="pc p3">3</span></div></div>
			</div>
			<b>Copied three times</b>
			<small>one copy of every piece in each zone, so one broken room never matters</small>
		</div>
	</div>
}

templ flowsSlide() {
	<div>
		<div class="flow-h">Saving a file</div>
		<ol class="steps">
			<li><b>Knock</b><span>The front door checks your key, just like Amazon S3.</span></li>
			<li><b>Split</b><span>The file is cut into 4 MB pieces; each gets a fingerprint.</span></li>
			<li><b>Spread</b><span>Every piece goes to 3 servers in 3 zones, all at once.</span></li>
			<li><b>Confirm</b><span>As soon as 2 servers say “got it”, we move on.</span></li>
			<li><b>Record</b><span>The librarians vote the new file into the catalog. Saved ✓</span></li>
		</ol>
	</div>
	<div>
		<div class="flow-h">Opening a file</div>
		<ol class="steps">
			<li><b>Look up</b><span>Ask the librarians which pieces make up the file, and where they live.</span></li>
			<li><b>Fetch</b><span>Grab each piece from a healthy server and check its fingerprint.</span></li>
			<li><b>Fall back</b><span>Copy missing, slow or damaged? Quietly use another one, and report it for repair.</span></li>
		</ol>
	</div>
}

templ safetySlide() {
	<table class="grid-t safety">
		<tr><th>Level</th><th>Copies kept</th><th>Space used</th><th>Files survive losing</th><th>Good for</th></tr>
		<tr><td>Scratch</td><td>1</td><td>1×</td><td>nothing</td><td>caches, temporary files</td></tr>
		<tr><td>Everyday</td><td>2</td><td>2×</td><td>1 server</td><td>data you can re-create</td></tr>
		<tr><td>Standard (default)</td><td>3</td><td>3×</td><td>2 servers</td><td>most things</td></tr>
		<tr><td>Critical</td><td>5</td><td>5×</td><td>4 servers</td><td>records you can never lose</td></tr>
	</table>
	<p class="plain">Identical pieces are stored only once, so a duplicate file costs almost nothing extra.</p>
}

// ---- live panels (polled by the slides) ----

templ nodeChip(n LiveNode) {
	<span class={ "chip", n.State }>
		<span class={ "dot", templ.KV("ok", n.State == "up"), templ.KV("warn", n.State == "impaired"), templ.KV("bad", n.State == "down") }></span>
		{ n.ID }
		<small>{ fmt.Sprint(n.Chunks) }</small>
	</span>
}

templ liveEvents(l Live) {
	if len(l.Events) > 0 {
		<ul class="lh-ev">
			for _, e := range l.Events {
				<li class={ e.Kind }><span class="ic">{ e.Icon }</span><span>{ e.Text }</span><time>{ e.Time }</time></li>
			}
		</ul>
	}
}

templ liveStatus(l Live) {
	{{ label, class := l.Status() }}
	<div class="lh-top">
		<span class={ "dot", class }></span><b>{ label }</b>
		if l.Healing != "" {
			<span class="muted">{ "for " + l.Healing }</span>
		}
	</div>
}

templ LiveHealth(l Live) {
	<div class="lh">
		@liveStatus(l)
		<div class="lh-nums">
			<div><b>{ fmt.Sprint(l.Missing) }</b><span>pieces missing a copy</span></div>
			<div><b>{ l.MTTR }</b><span>time of the last full repair</span></div>
			<div><b>{ l.Pct }</b><span>of pieces fully copied</span></div>
		</div>
		<div>
			<svg class="spark" viewBox="0 0 240 44" preserveAspectRatio="none" role="img" aria-label="Pieces missing a copy over the last minute">
				<line x1="0" x2="240" y1="42" y2="42"></line>
				<polyline points={ l.Spark }></polyline>
			</svg>
			<div class="spark-l">pieces missing a copy · last minute (max { fmt.Sprint(l.SparkMax) })</div>
		</div>
		<div class="lh-nodes">
			for _, n := range l.Nodes {
				@nodeChip(n)
			}
		</div>
		@liveEvents(l)
	</div>
}

templ LiveRaft(l Live) {
	<div class="lh">
		<div class="lh-top"><b>The librarians</b><span class="muted">★ marks the current leader</span></div>
		<div class="members">
			for _, r := range l.Raft {
				<div class={ "member big", templ.KV("leader", r.State == "Leader") }>
					<span class={ "dot", templ.KV("ok", r.Up && r.State == "Leader"), templ.KV("idle", r.Up && r.State != "Leader"), templ.KV("bad", !r.Up) }></span>
					<b>
						if r.State == "Leader" {
							★
						}
						{ r.ID }
					</b>
					if r.Up {
						<span class="muted">{ r.State } · term { fmt.Sprint(r.Term) }</span>
					} else {
						<span class="muted">unreachable</span>
					}
				</div>
			}
		</div>
		@liveStatus(l)
		@liveEvents(l)
	</div>
}

templ LiveBars(l Live) {
	<div class="lh">
		<div class="lh-top"><b>Pieces per server</b></div>
		<div class="lbars">
			for _, n := range l.Nodes {
				<div class={ "lbar", n.State }>
					<span><b>{ n.ID }</b> <small>{ n.Zone }</small></span>
					<span class="track"><span class="fill" style={ n.Width(l.MaxChunks) }></span></span>
					<span>{ fmt.Sprint(n.Chunks) }</span>
				</div>
			}
		</div>
		@liveEvents(l)
	</div>
}

templ LiveArch(l Live) {
	<div class="arch2">
		<div class="tier">
			<div class="tl">Your apps</div>
			<div class="tb"><span class="box">aws CLI</span><span class="box">Python · Go · Java SDKs</span><span class="box">Vault OS</span></div>
			<div class="tn">They speak the standard S3 language, so nothing needs rewriting.</div>
		</div>
		<div class="down-arrow">↓</div>
		<div class="tier">
			<div class="tl">Front door<small>gateway</small></div>
			<div class="tb"><span class="box strong">Checks keys · cuts files into pieces · sends them out</span></div>
			<div class="tn">Holds no data of its own, so you can run as many as traffic needs.</div>
		</div>
		<div class="down-arrow">↓ asks the librarians where things are · sends pieces straight to the warehouses ↓</div>
		<div class="two">
			<div class="tier col">
				<div class="tl">Librarians<small>metadata · 3 members voting with Raft</small></div>
				<div class="tb">
					for _, r := range l.Raft {
						<span class="chip">
							<span class={ "dot", templ.KV("ok", r.Up && r.State == "Leader"), templ.KV("idle", r.Up && r.State != "Leader"), templ.KV("bad", !r.Up) }></span>
							if r.State == "Leader" {
								★
							}
							{ r.ID }
						</span>
					}
				</div>
				<div class="tn">Keep the catalog: which file is made of which pieces, and where each piece lives. A change counts only when a majority agrees.</div>
			</div>
			<div class="tier col">
				<div class="tl">Warehouses<small>storage servers, grouped in zones</small></div>
				<div class="tb">
					for _, z := range l.Zones {
						<div class="zbox">
							<b>{ z.Name }</b>
							for _, n := range z.Nodes {
								@nodeChip(n)
							}
						</div>
					}
				</div>
				<div class="tn">Hold the pieces, and keep re-checking them for damage in the background.</div>
			</div>
		</div>
		<div class="care">
			<b>Caretaker</b>
			<span class="loop">runs on the lead librarian, every second: notice failures → rebuild missing copies → rebalance → clean up</span>
			<span style="flex:1"></span>
			@liveStatus(l)
		</div>
	</div>
}

templ LiveRecap(l Live) {
	<div class="recap-nums">
		<div><b>{ l.Pct }</b><span>of pieces fully copied right now</span></div>
		<div><b>{ fmt.Sprint(l.Repairs) }</b><span>copies rebuilt automatically</span></div>
		<div><b>{ l.MTTR }</b><span>last full recovery</span></div>
		<div>
			<b>{ fmt.Sprint(l.Lost) }</b>
			<span>pieces lost</span>
		</div>
	</div>
}

// SampleView shows where each piece of a freshly saved file landed.
templ SampleView(r SampleResult) {
	<div class="sample">
		<div><b>Saved { r.Name }</b> <span class="muted">{ r.Size } · { fmt.Sprint(len(r.Pieces)) } pieces, each kept on 3 servers in different zones</span></div>
		for _, p := range r.Pieces {
			<div class="srow">
				<span class={ "pc", fmt.Sprintf("p%d", (p.N-1)%3+1) }>{ fmt.Sprint(p.N) }</span>
				<code title="fingerprint (SHA-256)">{ p.Fingerprint }…</code>
				<span class="muted">→</span>
				for _, h := range p.Holders {
					<span class="chip">{ h.ID }<small>{ h.Zone }</small></span>
				}
			</div>
		}
	</div>
}
